# Copiar a .env (gitignorado) para desarrollo local.
# En producción, estas mismas van en Vercel > Settings > Environment Variables.

# Analítica. Sin esto no se carga ni un script de Google.
PUBLIC_GA4_ID=

# Verificación de Search Console por etiqueta HTML.
# Normalmente vacío: el valor por defecto ya está fijado en el Layout.
PUBLIC_GSC_VERIFICATION=

# Sheet de leads y señales (Apps Script desplegado como aplicación web).
# PUBLIC_SHEET_TOKEN es el TOKEN_WEB del script, no el SECRETO.
# Es público por diseño: acaba en el JavaScript de la web.
# La URL real NO va aquí: este fichero está en un repositorio público.
# Se configura en Vercel > Settings > Environment Variables.
PUBLIC_SHEET_URL=
PUBLIC_SHEET_TOKEN=
