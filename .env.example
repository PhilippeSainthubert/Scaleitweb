# Copiar a .env (gitignorado) para desarrollo local.
# En producción, estas mismas van en Vercel > Settings > Environment Variables.

# Analítica. Sin esto no se carga ni un script de Google.
PUBLIC_GA4_ID=

# Verificación de Search Console por etiqueta HTML.
# Normalmente vacío: el valor por defecto ya está fijado en el Layout.
PUBLIC_GSC_VERIFICATION=

# Sheet de leads y señales (Apps Script desplegado como aplicación web).
# PUBLIC_SHEET_TOKEN es el TOKEN_WEB del script, no el SECRETO.
# Es público por diseño: acaba en el JavaScript de la web.
# La URL real NO va aquí: este fichero está en un repositorio público.
# Se configura en Vercel > Settings > Environment Variables.
PUBLIC_SHEET_URL=
PUBLIC_SHEET_TOKEN=

# ── Auditoría SEO e IA (/auditoria-seo-ia) ────────────────────────
# Solo en Vercel > Environment Variables (nunca en el repo: es público).
# Pon un límite de gasto mensual en el panel de cada proveedor.
#
# Firma de los tickets de la auditoría. Cualquier cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUDITORIA_SECRETO=
# Claude: entiende la web, contesta como motor, extrae marcas y escribe el plan.
ANTHROPIC_API_KEY=
# ChatGPT (Responses API con búsqueda web).
OPENAI_API_KEY=
# Perplexity (API Sonar).
PERPLEXITY_API_KEY=
# Opcionales: cambiar de modelo sin tocar código.
# AUDITORIA_CLAUDE_MODEL=claude-opus-5-5
# AUDITORIA_OPENAI_MODEL=gpt-5-mini
# AUDITORIA_PERPLEXITY_MODEL=sonar
