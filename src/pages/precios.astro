---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Formulario from '../components/Formulario.astro';
import Acordeon from '../components/Acordeon.astro';
import CieloEstrellado from '../components/CieloEstrellado.astro';

const productos = [
  {
    nombre: 'Blueprint',
    formato: 'Una o dos semanas',
    lead: 'El diagnóstico y la arquitectura.',
    descripcion:
      'Auditamos funnel, stack, datos y equipo. Salís con el mapa del sistema, las prioridades ordenadas por impacto y el plan de ejecución. Es tuyo, lo hagas con nosotros o sin nosotros.',
    incluye: [
      'Auditoría de adquisición, datos y CRM',
      'Arquitectura del sistema propuesto',
      'Prioridades ordenadas por impacto y esfuerzo',
      'Plan de ejecución con plazos',
    ],
  },
  {
    nombre: 'Build Sprint',
    formato: 'De cuatro a ocho semanas',
    lead: 'La construcción.',
    descripcion:
      'Montamos el sistema: CRM y RevOps, tracking y atribución, infraestructura y secuencias de outbound, base técnica de SEO y los agentes que van a operarlo.',
    incluye: [
      'Todo lo que salga priorizado del Blueprint',
      'Agentes construidos y conectados a tu stack',
      'Tracking y atribución funcionando',
      'Documentación y traspaso al equipo',
    ],
    destacado: true,
  },
  {
    nombre: 'Growth Partner',
    formato: 'Mensual',
    lead: 'La operación.',
    descripcion:
      'Los agentes ejecutan a diario y nosotros supervisamos cada entrega. Reunión semanal, panel abierto y decisiones sobre datos, no sobre intuición.',
    incluye: [
      'Operación diaria del sistema completo',
      'Supervisión humana de cada entrega',
      'Reunión semanal y panel en tiempo real',
      'Procesos nuevos entrando al sistema cada mes',
    ],
  },
  {
    nombre: 'Agentes a medida',
    formato: 'Por agente',
    lead: 'La automatización concreta.',
    descripcion:
      'Un proceso repetitivo que se lleva horas de tu equipo, convertido en un agente con límites escritos, supervisión y trazabilidad.',
    incluye: [
      'Mapa del proceso y coste actual en horas',
      'Agente construido, conectado y documentado',
      'Límites duros y protocolo de escalado',
      'Formación al equipo que va a convivir con él',
    ],
  },
];

const fases = productos.slice(0, 3);
const suelto = productos[3];

const factores = [
  {
    titulo: 'Cuántas estrategias entran',
    texto: 'No cuesta lo mismo montar solo outbound que outbound, SEO y RevOps a la vez. Cada canal suma infraestructura, herramientas y supervisión.',
  },
  {
    titulo: 'Cómo esté el punto de partida',
    texto: 'Un CRM limpio con tracking decente acorta semanas. Uno con tres años de datos sucios y sin atribución, las alarga.',
  },
  {
    titulo: 'El volumen de la operación',
    texto: 'Operar cien cuentas al mes y operar tres mil no son el mismo trabajo, ni el mismo coste de datos y herramientas.',
  },
  {
    titulo: 'Cuántos agentes hay que construir',
    texto: 'Cada proceso automatizado es diseño, construcción, límites y supervisión. Se cobran por separado porque se entregan por separado.',
  },
  {
    titulo: 'Con qué velocidad lo querés',
    texto: 'Comprimir un Build Sprint de ocho semanas en cuatro es posible y se nota en el precio, porque significa dedicarte a vos el calendario entero.',
  },
];

const faq = [
  {
    q: '¿Por qué no publicáis los precios?',
    a: 'Porque publicar una cifra obliga a inventar un cliente medio que no existe. Preferimos mirar tu caso media hora y darte un número que se sostenga, en vez de una tarifa que luego se llena de extras.',
  },
  {
    q: '¿Cobráis un porcentaje de la inversión publicitaria?',
    a: 'No. Tarifa cerrada, siempre. Cobrar un porcentaje del gasto convierte nuestro incentivo en que gastes más, y eso es exactamente lo contrario de lo que nos contratás.',
  },
  {
    q: '¿Hay permanencia?',
    a: 'En la operación mensual, no. El Blueprint y el Build Sprint tienen alcance y precio cerrados de antemano. Si algún mes no aportamos, te vas, y lo construido se queda con vos documentado.',
  },
  {
    q: '¿Puedo empezar solo por el Blueprint?',
    a: 'Es lo que recomendamos. Sale con precio fijo, te llevás la arquitectura y el plan, y decidís después si lo ejecutamos nosotros o tu equipo.',
  },
  {
    q: '¿Qué presupuesto mínimo tiene sentido?',
    a: 'Si el ticket anual de tu producto está por debajo de unos 6.000 euros, el outbound no devuelve lo que cuesta y te lo diremos en la primera llamada. En ese caso la conversación va por SEO y producto, no por secuencias.',
  },
  {
    q: '¿Las herramientas van aparte?',
    a: 'Sí, y te decimos cuáles y cuánto antes de firmar nada. Las licencias se contratan a tu nombre: son tuyas, y el día que dejemos de trabajar juntos no se apaga nada.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Precios | Scale It"
  description="Cuatro formas de trabajar con nosotros y qué mueve el precio de cada una. Tarifa cerrada, nunca un porcentaje de tu inversión publicitaria."
  schema={schema}
>
  <Navbar />

  <main>
    <PageHero
      eyebrow="Precios"
      figuras={['pulpo']}
      titulo="El precio depende de lo que haya que montar"
      entradilla="No es una evasiva: montar solo outbound y montar el sistema entero no cuestan lo mismo, y una tarifa publicada obligaría a inventar un cliente medio que no existe. Abajo está exactamente qué mueve el número."
    />

    <!-- Las tres fases van en orden y la del medio es la que más se pide; los
         agentes sueltos se contratan aparte, por eso van debajo y a lo ancho. -->
    <section class="py-28 sm:py-36">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-2xl" data-revelar-grupo>
          <p class="eyebrow">Cómo se contrata</p>
          <h2 class="display-lg mt-4 text-balance">Tres fases en orden, o un agente suelto</h2>
          <p class="lede mt-5">Podés entrar por el Blueprint y parar ahí. Cada fase se paga cerrada y lo que se construye queda a tu nombre.</p>
        </div>

        <ol class="fases-precio mt-16" data-revelar-grupo="110">
          {fases.map((p, i) => (
            <li class:list={['precio-tarjeta', p.destacado && 'noche precio-destacada']}>
              {p.destacado && <CieloEstrellado semilla={9} densidad={0.35} brillo={false} />}
              <p class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em]">
                <span class="text-accent">Fase {i + 1}</span>
                {p.destacado ? <span class="precio-chip">El más pedido</span> : <span class="text-ink-3">{p.formato}</span>}
              </p>
              <h3 class="mt-6 text-[2rem] font-semibold leading-none tracking-[-0.035em] text-ink">{p.nombre}</h3>
              {p.destacado && <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{p.formato}</p>}
              <p class="mt-4 text-[15.5px] font-medium text-accent-deep">{p.lead}</p>
              <p class="mt-3 text-[14.5px] leading-relaxed text-ink-2">{p.descripcion}</p>
              <ul class="mt-6 space-y-2.5 border-t border-line pt-5">
                {p.incluye.map((x) => (
                  <li class="flex items-start gap-2.5 text-[14px] text-ink">
                    <svg class="mt-[3px] h-3.5 w-3.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    {x}
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex items-center justify-between gap-4 border-t border-line pt-5">
                <span class="text-[13.5px] text-ink-3">A consultar en la llamada</span>
                <a href="#contacto" class:list={['btn', p.destacado ? 'btn-primary' : 'btn-ghost']}>Pedir número</a>
              </div>
            </li>
          ))}
        </ol>

        <article class="precio-suelto mt-5" data-revelar>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Aparte · {suelto.formato}</p>
            <h3 class="mt-4 text-[1.75rem] font-semibold leading-none tracking-[-0.035em] text-ink">{suelto.nombre}</h3>
            <p class="mt-3 text-[15.5px] font-medium text-accent-deep">{suelto.lead}</p>
            <p class="mt-3 max-w-[46ch] text-[14.5px] leading-relaxed text-ink-2">{suelto.descripcion}</p>
          </div>
          <ul class="space-y-2.5">
            {suelto.incluye.map((x) => (
              <li class="flex items-start gap-2.5 text-[14px] text-ink">
                <svg class="mt-[3px] h-3.5 w-3.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                {x}
              </li>
            ))}
            <li class="pt-3"><a href="#contacto" class="btn btn-ghost">Pedir número</a></li>
          </ul>
        </article>
      </div>
    </section>

    <section class="border-t border-line bg-surface py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28" data-revelar-grupo>
            <p class="eyebrow">Transparencia</p>
            <h2 class="display-lg mt-4 text-balance">Qué mueve el precio</h2>
            <p class="lede mt-5">
              Cinco variables. En la llamada las repasamos sobre tu caso y salís con un número, no con un rango.
            </p>
            <div class="precio-fijo mt-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-positive">Lo que nunca cambia</p>
              <p class="mt-3 text-[16px] leading-relaxed text-ink">
                Tarifa cerrada y acordada antes de empezar. Nunca un porcentaje de tu inversión publicitaria.
              </p>
            </div>
          </div>
        </div>
        <ul class="lg:col-span-7" data-revelar-grupo="90">
          {factores.map((f) => (
            <li class="factor">
              <h3 class="text-[19px] font-semibold tracking-[-0.02em] text-ink">{f.titulo}</h3>
              <p class="mt-2 text-[15.5px] leading-relaxed text-ink-2">{f.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-line py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4" data-revelar-grupo>
          <p class="eyebrow">Preguntas</p>
          <h2 class="display-lg mt-4 text-balance">Lo que se pregunta antes de la llamada</h2>
        </div>
        <div class="lg:col-span-8" data-revelar>
          <Acordeon preguntas={faq} />
        </div>
      </div>
    </section>

    <Formulario origen="precios" titulo="Media hora y salís con un número" texto="Repasamos tu caso, te decimos qué montaríamos primero y cuánto costaría. Si no somos la solución, también te lo decimos." />
  </main>

  <Footer />
</Layout>
