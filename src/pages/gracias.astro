---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Gracias | Scale It" description="Hemos recibido tu mensaje." noindex={true}>
  <Navbar />

  <main>
    <PageHero
      compacta
      eyebrow="Mensaje recibido"
      titulo="Recibido. Te respondemos en menos de 24 horas"
      entradilla="Lo lee uno de los dos, no un filtro automático. Si es urgente, escribinos directamente por LinkedIn y lo adelantamos."
      figuras={['pulpo']}
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href="/blog" class="btn btn-ghost">Leer el blog mientras tanto</a>
      </div>
    </PageHero>
  </main>

  <Footer />
</Layout>
