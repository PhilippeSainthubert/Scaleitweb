---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Error del servidor | Scale It" description="Algo ha fallado por nuestra parte." noindex={true}>
  <Navbar />

  <main>
    <PageHero
      compacta
      eyebrow="Error 500"
      titulo="Se rompió algo de nuestro lado"
      entradilla="No es cosa tuya. Probá a recargar en un minuto; si sigue igual, escribinos y lo miramos."
      figuras={['pulpo']}
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href="/#contacto" class="btn btn-ghost">Avisarnos</a>
      </div>
    </PageHero>
  </main>

  <Footer />
</Layout>
