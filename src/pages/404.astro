---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const enlaces = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Precios', href: '/precios' },
  { label: 'Blog', href: '/blog' },
  { label: 'Preguntas frecuentes', href: '/faq' },
];
---

<Layout title="Página no encontrada | Scale It" description="Esta página no existe." noindex={true}>
  <Navbar />

  <main>
    <PageHero
      compacta
      eyebrow="Error 404"
      titulo="Esta página no existe"
      entradilla="O la movimos, o el enlace venía roto. Por aquí sí hay cosas:"
      figuras={['pulpo']}
    >
      <div class="mt-8 flex flex-wrap gap-2.5">
        {enlaces.map((e) => (
          <a href={e.href} class="btn btn-ghost">{e.label}</a>
        ))}
      </div>
      <a href="/" class="btn btn-primary mt-6">Volver al inicio</a>
    </PageHero>
  </main>

  <Footer />
</Layout>
