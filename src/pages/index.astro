---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TaskTracker from '../components/TaskTracker.astro';
import Services from '../components/Services.astro';
import Comparativa from '../components/Comparativa.astro';
import Process from '../components/Process.astro';
import Nosotros from '../components/Nosotros.astro';
import Stack from '../components/Stack.astro';
import Formulario from '../components/Formulario.astro';
import Footer from '../components/Footer.astro';

const servicioSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Sistema de adquisición operado por agentes de IA',
  provider: { '@id': 'https://www.growth-scaleit.com/#organization' },
  areaServed: [
    { '@type': 'Country', name: 'España' },
    { '@type': 'Place', name: 'América Latina' },
  ],
  serviceType: 'Growth marketing y automatización con IA',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Scale It',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Outbound B2B' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SEO y contenido' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Agentes de IA a medida' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'RevOps y CRM' } },
    ],
  },
};

const personas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Philippe Saint-Hubert',
    jobTitle: 'Socio, sistemas y estrategia',
    worksFor: { '@id': 'https://www.growth-scaleit.com/#organization' },
    sameAs: [
      'https://www.linkedin.com/in/philippesainthubert/',
      'https://www.youtube.com/@Marketingdetrasdelclick',
      'https://x.com/Mktgdtrdelclick',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Patrick Saint-Hubert',
    jobTitle: 'Socio, outbound y generación de demanda',
    worksFor: { '@id': 'https://www.growth-scaleit.com/#organization' },
    sameAs: ['https://www.linkedin.com/in/patrick-saint-hubert-5b9560269/'],
  },
];
---

<Layout schema={[servicioSchema, ...personas]}>
  <Navbar />
  <main>
    <Hero />
    <TaskTracker />
    <Services />
    <Comparativa />
    <Process />
    <Nosotros />
    <Stack />
    <Formulario origen="home" />
  </main>
  <Footer />
</Layout>
