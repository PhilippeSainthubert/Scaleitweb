---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Formulario from '../../components/Formulario.astro';
import Ejemplos from '../../components/Ejemplos.astro';
import Formatos from '../../components/Formatos.astro';
import FirmaSocio from '../../components/FirmaSocio.astro';
import PageHero from '../../components/PageHero.astro';
import FiguraSVG from '../../components/FiguraSVG.astro';
import CieloEstrellado from '../../components/CieloEstrellado.astro';
import Constelacion from '../../components/Constelacion.astro';
import Acordeon from '../../components/Acordeon.astro';
import AuditoriaLanzador from '../../components/AuditoriaLanzador.astro';
import { AGENTES, AGENTE_SERVICIO } from '../../data/agentes';
import { servicios } from '../../data/servicios';

export function getStaticPaths() {
  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const agente = AGENTE_SERVICIO[servicio.slug] ?? 'pulpo';
const otros = servicios.filter((s) => s.slug !== servicio.slug).slice(0, 3);
const base = 'https://www.growth-scaleit.com';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: servicio.nombre,
    description: servicio.metaDescription,
    provider: { '@id': `${base}/#organization` },
    areaServed: [
      { '@type': 'Country', name: 'España' },
      { '@type': 'Place', name: 'América Latina' },
    ],
    url: `${base}/servicios/${servicio.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${base}/#servicios` },
      { '@type': 'ListItem', position: 3, name: servicio.nombre, item: `${base}/servicios/${servicio.slug}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: servicio.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={servicio.metaTitle} description={servicio.metaDescription} schema={schema}>
  <Navbar />

  <main>
    <PageHero
      titulo={servicio.h1}
      entradilla={servicio.entradilla}
      figuras={[agente]}
      ruta={[{ texto: 'Inicio', href: '/' }, { texto: servicio.pilar, href: '/#servicios' }, { texto: servicio.nombre }]}
    >
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#contacto" class="btn btn-primary">
          Agenda una llamada
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
        <a href="#incluye" class="btn btn-ghost">Qué incluye</a>
      </div>
    </PageHero>

    <!-- El problema: una sola idea, a tamaño de titular -->
    <section class="py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 lg:grid-cols-12 lg:gap-8">
        <p class="eyebrow lg:col-span-3 lg:pt-4" data-revelar>El problema</p>
        <div class="lg:col-span-9" data-revelar-grupo>
          <h2 class="display-lg text-balance">{servicio.problema.titulo}</h2>
          <p class="lede mt-7 text-pretty">{servicio.problema.texto}</p>
        </div>
      </div>
    </section>

    {servicio.slug === 'seo' && <AuditoriaLanzador />}

    <!-- Qué incluye: de noche, con el agente del servicio dibujándose al lado -->
    <section id="incluye" class="noche overflow-clip py-28 sm:py-36">
      <CieloEstrellado semilla={servicio.slug.length * 7 + 2} />
      <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <div data-revelar-grupo>
              <p class="eyebrow">Qué incluye</p>
              <h2 class="display-lg mt-4 text-balance">Lo que hacemos, sin letra pequeña</h2>
            </div>
            <figure class="mt-10 hidden lg:block">
              <FiguraSVG animal={agente} tema="noche" class="w-full max-w-[380px]" retraso={200} />
              <figcaption class="figura-leyenda mt-2">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                <span class="text-ink">{AGENTES[agente].nombre}</span>
                <span aria-hidden="true">·</span>
                <span>{AGENTES[agente].rol}</span>
              </figcaption>
            </figure>
          </div>
        </div>

        <ul class="incluye lg:col-span-7" data-revelar-grupo="90">
          {servicio.incluye.map((item) => (
            <li class="incluye-item">
              <span class="incluye-estrella" aria-hidden="true"></span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-[-0.02em] text-ink">{item.titulo}</h3>
                <p class="mt-2 max-w-[54ch] text-[15.5px] leading-relaxed text-ink-2">{item.texto}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Entregables y para quién -->
    <section class="py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <div data-revelar-grupo>
            <p class="eyebrow">Entregables</p>
            <h2 class="display-lg mt-4 text-balance">Qué te llevás, exactamente</h2>
          </div>
          <ul class="entregables mt-10" data-revelar-grupo="70">
            {servicio.entregables.map((e) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" /><path d="m7.5 12.5 3 3 6-7" pathLength="1" /></svg>
                <span>{e}</span>
              </li>
            ))}
          </ul>
        </div>

        <aside class="lg:col-span-5 lg:pt-24" data-revelar="derecha">
          <div class="para-quien">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">Para quién es</p>
            <p class="mt-5 text-[19px] leading-relaxed tracking-[-0.012em] text-ink">{servicio.paraQuien}</p>
          </div>
        </aside>
      </div>
    </section>

    <FirmaSocio servicio={servicio.slug} />

    <Ejemplos servicio={servicio.slug} />

    <Formatos servicio={servicio.slug} />

    <section class="border-t border-line py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4" data-revelar-grupo>
          <p class="eyebrow">Preguntas</p>
          <h2 class="display-lg mt-4 text-balance">Lo que nos preguntan siempre</h2>
        </div>
        <div class="lg:col-span-8" data-revelar>
          <Acordeon preguntas={servicio.faq} />
        </div>
      </div>
    </section>

    <!-- Otros servicios, antes del contacto para que el cierre sea de noche -->
    <section class="border-t border-line bg-surface py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="eyebrow">Seguir mirando</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-3" data-revelar-grupo>
          {otros.map((o) => (
            <div>
              <a href={`/servicios/${o.slug}`} class="otro-servicio group">
                <span class="flex items-center justify-between">
                  <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{o.pilar}</span>
                  <Constelacion animal={AGENTE_SERVICIO[o.slug] ?? 'pulpo'} size={34} />
                </span>
                <span class="mt-5 block text-[18px] font-semibold tracking-[-0.02em] text-ink">{o.nombre}</span>
                <span class="mt-2 block text-[14px] leading-relaxed text-ink-2">{o.entradilla.slice(0, 92)}...</span>
                <span class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-medium text-accent">
                  Ver servicio
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" /></svg>
                </span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Formulario
      origen={`servicio:${servicio.slug}`}
      titulo={`¿Hablamos de ${servicio.nombre.toLowerCase()}?`}
      texto="Media hora sobre tu caso concreto. Te decimos qué haríamos primero, en qué orden y cuánto costaría. Si no somos la solución, también te lo decimos."
    />
  </main>

  <Footer />
</Layout>
