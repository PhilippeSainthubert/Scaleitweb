---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { clusters } from '../../data/autores';
import { AGENTE_CLUSTER } from '../../data/agentes';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [destacado, ...resto] = posts;

// Solo los temas que tienen artículos, en el orden en que los presenta la web.
const temas = Object.entries(clusters)
  .map(([slug, nombre]) => ({ slug, nombre, total: posts.filter((p) => p.data.cluster === slug).length }))
  .filter((t) => t.total > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Scale It',
  url: 'https://www.growth-scaleit.com/blog',
  publisher: { '@id': 'https://www.growth-scaleit.com/#organization' },
};
---

<Layout
  title="Blog | Scale It"
  description="Cómo se construye y se opera un sistema de adquisición B2B: outbound, SEO, agentes de IA y RevOps. Sin humo y sin recetas de manual."
  schema={schema}
>
  <Navbar />

  <main>
    <PageHero
      eyebrow="Blog"
      titulo="Cómo se construye una máquina de adquisición"
      entradilla="Lo que aprendemos montando y operando estos sistemas. Sin recetas de manual y sin métricas de vanidad. Cada tema lo firma el agente que se ocupa de él."
      figuras={temas.map((t) => AGENTE_CLUSTER[t.slug] ?? 'pulpo')}
    />

    {posts.length === 0 ? (
      <section class="py-20">
        <p class="mx-auto max-w-6xl px-6 text-[15px] text-ink-2">Todavía no hay publicaciones. Vuelve pronto.</p>
      </section>
    ) : (
      <section class="py-14 sm:py-20" data-blog>
        <div class="mx-auto max-w-6xl px-6">
          {destacado && <TarjetaArticulo post={destacado} destacado />}

          <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-b border-line pb-5">
            <h2 class="text-[15px] font-semibold tracking-[-0.01em] text-ink">Todos los artículos</h2>
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tema">
              <button type="button" class="chip-tema" data-tema="" aria-pressed="true">
                Todos <span class="chip-total">{resto.length}</span>
              </button>
              {temas.map((t) => (
                <button type="button" class="chip-tema" data-tema={t.slug} aria-pressed="false">
                  {t.nombre} <span class="chip-total">{resto.filter((p) => p.data.cluster === t.slug).length}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-rejilla>
            {resto.map((post) => <TarjetaArticulo post={post} />)}
          </div>
          <p class="mt-10 hidden text-[15px] text-ink-2" data-vacio>No hay más artículos de este tema por ahora.</p>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<script>
  // Filtro por tema. Sin JavaScript se ven todos, que es un estado válido.
  document.querySelectorAll<HTMLElement>('[data-blog]').forEach((raiz) => {
    const chips = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-tema]'));
    const tarjetas = Array.from(raiz.querySelectorAll<HTMLElement>('[data-rejilla] [data-cluster]'));
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const tema = chip.dataset.tema ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        let visibles = 0;
        tarjetas.forEach((t) => {
          const ver = !tema || t.dataset.cluster === tema;
          t.hidden = !ver;
          if (ver) visibles++;
        });
        vacio?.classList.toggle('hidden', visibles > 0);
      })
    );
  });
</script>
