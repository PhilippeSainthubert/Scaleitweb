---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Formulario from '../../components/Formulario.astro';
import { autores, clusters, personId } from '../../data/autores';
import PageHero from '../../components/PageHero.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { AGENTE_CLUSTER } from '../../data/agentes';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const todos = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const relacionados = [
  ...todos.filter((p) => p.id !== post.id && p.data.cluster === post.data.cluster),
  ...todos.filter((p) => p.id !== post.id && p.data.cluster !== post.data.cluster),
].slice(0, 3);
const imagen = `/og/${post.id}.jpg`;
const { Content, headings } = await render(post);
const autor = autores[post.data.author];
const base = 'https://www.growth-scaleit.com';
// Sin barra final: el sitio es trailingSlash: 'never' y el canonical tampoco
// la lleva. Con barra, mainEntityOfPage y el breadcrumb apuntaban a una URL
// que redirige con 308, contradiciendo al canonical de la propia página.
const url = `${base}/blog/${post.id}`;

const indice = headings.filter((h) => h.depth === 2);

const fecha = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { '@id': personId[post.data.author] },
    publisher: { '@id': `${base}/#organization` },
    isPartOf: { '@id': `${base}/#website` },
    mainEntityOfPage: url,
    url,
    image: `${base}${imagen}`,
    articleSection: clusters[post.data.cluster],
    keywords: post.data.tags.join(', '),
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${base}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Layout title={`${post.data.title} | Scale It`} description={post.data.description} schema={schema} image={imagen}>
  <Navbar />

  <main>
    <article>
      <PageHero
        titularLargo
        titulo={post.data.title}
        entradilla={post.data.description}
        figuras={[AGENTE_CLUSTER[post.data.cluster] ?? 'pulpo']}
        ruta={[{ texto: 'Inicio', href: '/' }, { texto: 'Blog', href: '/blog' }, { texto: clusters[post.data.cluster] }]}
      >
        <div class="mt-8 flex items-center gap-3">
          <img src={autor.foto} alt="" width="40" height="40" class="h-10 w-10 rounded-full object-cover ring-2 ring-white" />
          <div class="text-[13.5px] leading-tight">
            <a href={autor.linkedin} target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-accent">
              {post.data.author}
            </a>
            <p class="mt-0.5 text-ink-3">
              <time datetime={post.data.pubDate.toISOString()}>{fecha(post.data.pubDate)}</time>
              {post.data.updatedDate && <span> · actualizado el {fecha(post.data.updatedDate)}</span>}
            </p>
          </div>
        </div>
      </PageHero>

      <div class="mx-auto max-w-6xl px-6 py-10 sm:py-14 lg:grid lg:grid-cols-12 lg:gap-12">
        {/* En escritorio el índice acompaña la lectura en un lateral fijo; en
            móvil va arriba, que es donde se busca. */}
        {indice.length > 2 && (
          <aside class="mb-10 lg:order-2 lg:col-span-3 lg:mb-0">
            {/* Móvil: desplegable cerrado, para no poner seis enlaces entre el
                titular y el primer párrafo. Escritorio: lateral fijo. */}
            <details class="indice-movil lg:hidden">
              <summary>En esta página <span class="font-mono text-[11px] text-ink-3">{indice.length}</span></summary>
              <ul class="mt-3 space-y-2.5">
                {indice.map((h) => (
                  <li><a href={`#${h.slug}`} class="indice-enlace">{h.text}</a></li>
                ))}
              </ul>
            </details>
            <nav aria-label="Contenidos" class="indice-articulo hidden lg:block">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">En esta página</p>
              <ul class="mt-3.5 space-y-2.5">
                {indice.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-indice={h.slug} class="indice-enlace">{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        <div class="post-body lg:order-1 lg:col-span-8 lg:col-start-1">
          <Content />
        </div>
      </div>
    </article>

    {relacionados.length > 0 && (
      <section class="border-t border-line bg-surface py-16 sm:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="display-md">Sigue leyendo</h2>
          <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((r) => <TarjetaArticulo post={r} />)}
          </div>
        </div>
      </section>
    )}

    <Formulario origen="blog" titulo="¿Te suena de algo lo que acabás de leer?" texto="Media hora, miramos tu caso concreto y te decimos por dónde empezaríamos." />
  </main>

  <Footer />
</Layout>

<script>
  // Bloques de código de los artículos: botón de copiar en todos, y la skill
  // completa plegada con opción de verla entera. Se hace aquí y no en el
  // markdown para que el texto siga íntegro en el HTML: los rastreadores y
  // quien navegue sin JavaScript leen la skill entera.
  const ETIQUETAS: Record<string, string> = { bash: 'Terminal', json: 'JSON', yaml: 'YAML' };

  function prepararCodigo() {
    document.querySelectorAll<HTMLPreElement>('.post-body pre:not([data-preparado])').forEach((pre) => {
      pre.dataset.preparado = '';
      const texto = (pre.querySelector('code') ?? pre).textContent ?? '';
      const esSkill = /^---\s*\nname:/.test(texto.trimStart());

      const caja = document.createElement('div');
      caja.className = esSkill ? 'codigo codigo--skill' : 'codigo';
      pre.replaceWith(caja);
      caja.append(pre);

      const barra = document.createElement('div');
      barra.className = 'codigo-barra';
      const etiqueta = document.createElement('span');
      etiqueta.className = 'codigo-etiqueta';
      etiqueta.textContent = esSkill ? 'SKILL.md' : ETIQUETAS[pre.dataset.language ?? ''] ?? '';

      const copiar = document.createElement('button');
      copiar.type = 'button';
      copiar.className = 'codigo-copiar';
      copiar.textContent = 'Copiar';
      copiar.setAttribute('aria-live', 'polite');
      copiar.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(texto);
        } catch {
          // Sin permiso de portapapeles: se selecciona el bloque y se copia
          // a la antigua, que sigue funcionando en todos los navegadores.
          const rango = document.createRange();
          rango.selectNodeContents(pre);
          const seleccion = getSelection();
          seleccion?.removeAllRanges();
          seleccion?.addRange(rango);
          document.execCommand('copy');
          seleccion?.removeAllRanges();
        }
        copiar.textContent = 'Copiado';
        copiar.dataset.copiado = '';
        setTimeout(() => {
          copiar.textContent = 'Copiar';
          delete copiar.dataset.copiado;
        }, 1800);
      });

      barra.append(etiqueta, copiar);
      caja.append(barra);

      if (esSkill) {
        const desplegar = document.createElement('button');
        desplegar.type = 'button';
        desplegar.className = 'codigo-desplegar';
        desplegar.textContent = 'Ver la skill entera';
        desplegar.setAttribute('aria-expanded', 'false');
        desplegar.addEventListener('click', () => {
          const abierto = caja.classList.toggle('is-abierto');
          desplegar.textContent = abierto ? 'Plegar' : 'Ver la skill entera';
          desplegar.setAttribute('aria-expanded', String(abierto));
          if (!abierto) caja.scrollIntoView({ block: 'start', behavior: 'smooth' });
        });
        caja.append(desplegar);
      }
    });
  }

  prepararCodigo();
  document.addEventListener('astro:page-load', prepararCodigo);
</script>

<script>
  // Resalta en el índice la sección que se está leyendo.
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-indice]'));
  if (enlaces.length) {
    const secciones = enlaces
      .map((a) => document.getElementById(a.dataset.indice!))
      .filter((s): s is HTMLElement => !!s);
    const marcar = (id: string) =>
      enlaces.forEach((a) => a.setAttribute('aria-current', String(a.dataset.indice === id)));
    const io = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) marcar(visible.target.id);
      },
      { rootMargin: '-96px 0px -65% 0px' }
    );
    secciones.forEach((s) => io.observe(s));
  }
</script>
