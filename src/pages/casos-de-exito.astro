---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Formulario from '../components/Formulario.astro';

const contenido = [
  'El punto de partida real, con sus números',
  'Qué se construyó y en qué orden',
  'Qué falló por el camino y cómo se corrigió',
  'Los resultados a tres, seis y doce meses',
  'Qué haríamos distinto si empezáramos hoy',
];

const fundadores = [
  { t: 'Precio de fundador', d: 'Condiciones cerradas durante los primeros doce meses, por debajo de la tarifa.' },
  { t: 'Acceso directo', d: 'Trabajás con los dos socios, sin intermediarios. Eso no cambia después.' },
  { t: 'Caso documentado', d: 'A cambio, publicamos lo aprendido. Con tu revisión y tu aprobación antes de nada.' },
];
---

<Layout
  title="Casos | Scale It"
  description="Todavía no publicamos casos de éxito, y explicamos por qué. Programa de clientes fundadores abierto: tres plazas con condiciones cerradas."
>
  <Navbar />

  <main>
    <PageHero
      eyebrow="Casos"
      figuras={['hormiga']}
      titulo="Todavía no tenemos casos que enseñarte"
      entradilla="Podríamos rellenar esta página con tres historias de una fintech anónima y unos porcentajes bonitos. Lo hace medio sector. Preferimos decirte dónde estamos."
    />

    <section class="py-28 sm:py-36">
      <div class="mx-auto grid max-w-6xl gap-16 px-6 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-6" data-revelar-grupo>
          <p class="text-[22px] font-medium leading-[1.45] tracking-[-0.018em] text-ink sm:text-[26px]">
            Scale It como agencia de los dos es nueva. Lo que no es nuevo es el
            trabajo.
          </p>
          <p class="mt-6 text-[16px] leading-relaxed text-ink-2">
            Philippe lleva años montando sistemas de growth para empresas tech y
            fintech, y Patrick viene de outbound. Esa trayectoria está en nuestros
            perfiles de LinkedIn, que es donde podés comprobarla, y no en un
            testimonio que nadie puede verificar.
          </p>
          <p class="mt-5 text-[16px] leading-relaxed text-ink-2">
            Cuando publiquemos un caso será uno real, con permiso del cliente y
            con las cifras que se puedan enseñar. Mientras tanto, esta página
            dice la verdad, que nos parece mejor carta de presentación que un
            «Carlos M., CEO» con foto de banco de imágenes.
          </p>
        </div>

        <!-- La plantilla del caso, esperando al primero -->
        <figure class="lg:col-span-6" data-revelar="escala">
          <div class="plantilla">
            <p class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">
              <span>Caso 01</span>
              <span class="flex items-center gap-1.5 text-accent"><span class="plantilla-pulso" aria-hidden="true"></span>Esperando cliente</span>
            </p>
            <h2 class="mt-5 text-[22px] font-semibold tracking-[-0.025em] text-ink">Qué va a llevar cada caso</h2>
            <ol class="plantilla-secciones mt-6">
              {contenido.map((c, i) => (
                <li style={`--i:${i}`}>
                  <p class="text-[14.5px] text-ink">{c}</p>
                  <span class="plantilla-lineas" aria-hidden="true"><i></i><i></i></span>
                </li>
              ))}
            </ol>
          </div>
          <figcaption class="mt-5 max-w-[46ch] text-[14.5px] leading-relaxed text-ink-3">
            Incluido lo que salió mal. Un caso donde todo funciona a la primera
            no es un caso, es un anuncio.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="border-t border-line bg-surface py-28 sm:py-36">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-2xl" data-revelar-grupo>
          <p class="eyebrow">Clientes fundadores</p>
          <h2 class="display-lg mt-4 text-balance">Tres plazas, y quien entra ahora entra mejor</h2>
          <p class="lede mt-5">
            Necesitamos casos y vos necesitás resultados. El trato es explícito y
            no tiene letra pequeña.
          </p>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-3" data-revelar-grupo="110">
          {fundadores.map((f) => (
            <div class="fundador">
              <h3 class="text-[19px] font-semibold tracking-[-0.02em] text-ink">{f.t}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-2">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Formulario origen="casos" titulo="¿Te interesa una de las tres plazas?" texto="Media hora para ver si encajamos. Si tu caso no nos sirve como caso, también te lo decimos." />
  </main>

  <Footer />
</Layout>
