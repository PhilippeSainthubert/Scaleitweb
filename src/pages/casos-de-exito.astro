---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Formulario from '../components/Formulario.astro';

const contenido = [
  'El punto de partida real, con sus números',
  'Qué se construyó y en qué orden',
  'Qué falló por el camino y cómo se corrigió',
  'Los resultados a tres, seis y doce meses',
  'Qué haríamos distinto si empezáramos hoy',
];

const fundadores = [
  { t: 'Precio de fundador', d: 'Condiciones cerradas durante los primeros doce meses, por debajo de la tarifa.' },
  { t: 'Acceso directo', d: 'Trabajás con los dos socios, sin intermediarios. Eso no cambia después.' },
  { t: 'Caso documentado', d: 'A cambio, publicamos lo aprendido. Con tu revisión y tu aprobación antes de nada.' },
];
---

<Layout
  title="Casos | Scale It"
  description="Todavía no publicamos casos de éxito, y explicamos por qué. Programa de clientes fundadores abierto: tres plazas con condiciones cerradas."
>
  <Navbar />

  <main>
    <PageHero
      eyebrow="Casos"
      titulo="Todavía no tenemos casos que enseñarte"
      entradilla="Podríamos rellenar esta página con tres historias de una fintech anónima y unos porcentajes bonitos. Lo hace medio sector. Preferimos decirte dónde estamos."
    />

    <section class="py-20 sm:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <div class="prose-measure text-[16px] leading-relaxed text-ink-2">
          <p>
            Scale It como agencia de los dos es nueva. Lo que no es nuevo es el
            trabajo: Philippe lleva años montando sistemas de growth para
            empresas tech y fintech, y Patrick viene de outbound. Esa trayectoria
            está en nuestros perfiles de LinkedIn, que es donde podés
            comprobarla, y no en un testimonio que nadie puede verificar.
          </p>
          <p class="mt-5">
            Cuando publiquemos un caso será uno real, con permiso del cliente y
            con las cifras que se puedan enseñar. Mientras tanto, esta página
            dice la verdad, que nos parece mejor carta de presentación que un
            «Carlos M., CEO» con foto de banco de imágenes.
          </p>
        </div>

        <div class="mt-14 rounded-xl border border-line bg-surface p-8">
          <h2 class="display-md">Qué va a llevar cada caso</h2>
          <ul class="mt-6 space-y-3">
            {contenido.map((c) => (
              <li class="flex items-start gap-3 text-[15px] leading-relaxed text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {c}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-[14.5px] leading-relaxed text-ink-3">
            Incluido lo que salió mal. Un caso donde todo funciona a la primera
            no es un caso, es un anuncio.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="eyebrow">Clientes fundadores</p>
        <h2 class="display-lg mt-4 max-w-2xl text-balance">Tres plazas, y quien entra ahora entra mejor</h2>
        <p class="lede mt-5">
          Necesitamos casos y vos necesitás resultados. El trato es explícito y
          no tiene letra pequeña.
        </p>

        <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
          {fundadores.map((f, i) => (
            <div class="bg-bg p-7">
              <span class="font-mono text-[11px] text-accent">0{i + 1}</span>
              <h3 class="mt-3 text-[17px] font-semibold tracking-[-0.02em] text-ink">{f.t}</h3>
              <p class="mt-2.5 text-[14px] leading-relaxed text-ink-2">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Formulario origen="casos" titulo="¿Te interesa una de las tres plazas?" texto="Media hora para ver si encajamos. Si tu caso no nos sirve como caso, también te lo decimos." />
  </main>

  <Footer />
</Layout>
