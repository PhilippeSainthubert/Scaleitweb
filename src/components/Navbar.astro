---
const links = [
  { label: 'Cómo funciona', href: '/#agentes' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Proceso', href: '/#proceso' },
  { label: 'Nosotros', href: '/#nosotros' },
  { label: 'Precios', href: '/precios' },
  { label: 'FAQ', href: '/faq' },
];
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-bg/80 backdrop-blur-xl transition-[border-color,box-shadow] duration-300">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <a href="/" class="text-[17px] font-semibold tracking-[-0.02em] text-ink">
      Scale It
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {links.map((link) => (
        <a href={link.href} class="text-[14px] text-ink-2 transition-colors hover:text-ink">
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="/#contacto" class="btn btn-primary hidden sm:inline-flex">Hablemos</a>
      <button id="mobile-menu-btn" class="p-2 text-ink lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg lg:hidden">
    <div class="space-y-1 px-6 py-4">
      {links.map((link) => (
        <a href={link.href} class="block py-2 text-[15px] text-ink-2 transition-colors hover:text-ink">
          {link.label}
        </a>
      ))}
      <a href="/#contacto" class="btn btn-primary mt-3 w-full">Hablemos</a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    // La barra solo se separa del fondo cuando hay contenido detrás.
    var nav = document.getElementById('site-nav');
    if (nav) {
      var onScroll = function () {
        var scrolled = window.scrollY > 8;
        nav.classList.toggle('border-line', scrolled);
        nav.classList.toggle('border-transparent', !scrolled);
        nav.classList.toggle('shadow-sm', scrolled);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>
