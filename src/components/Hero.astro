---
import NodeBurst from './NodeBurst.astro';

const pillars = ['Diseñamos', 'Construimos', 'Operamos'];
---

<section class="relative overflow-hidden">
  <!-- El abanico de nodos: un origen, cientos de acciones.
       No es decoración, es el argumento de la marca. -->
  <div class="absolute inset-x-0 bottom-0 top-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-surface-2 via-bg to-bg"></div>
    <NodeBurst
      class="absolute inset-x-0 bottom-0 h-[66%] [mask-image:radial-gradient(140%_100%_at_50%_100%,#000_56%,transparent_92%)]"
    />
    <!-- Velo blanco radial: el texto tiene que apoyarse sobre blanco, no sobre
         los rayos. Es el truco que usa Stripe para que el gráfico no compita
         con la lectura. -->
    <div class="absolute inset-0 bg-[radial-gradient(66%_56%_at_50%_34%,#fff_42%,rgba(255,255,255,.9)_68%,rgba(255,255,255,0)_100%)]"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-44 pt-36 sm:pb-56 sm:pt-44">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">Agentes de IA · supervisión humana</p>

      <h1 class="display-xl mt-5 text-balance">
        Tu máquina de adquisición, operada por agentes de IA
      </h1>

      <p class="lede mx-auto mt-6 text-balance">
        No vendemos horas. Construimos el sistema que capta, convierte y mide,
        y lo operamos con agentes supervisados por nosotros dos, todos los días.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/#contacto" class="btn btn-primary">
          Agenda una llamada
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
        <a href="/#agentes" class="btn btn-ghost">Ver el sistema por dentro</a>
      </div>

      <!-- Un sistema. Cientos de acciones al día. -->
      <div class="mt-14 flex items-center justify-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-2">
        {pillars.map((p, i) => (
          <>
            {i > 0 && <span class="h-1 w-1 rounded-full bg-line-2"></span>}
            <span>{p}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
