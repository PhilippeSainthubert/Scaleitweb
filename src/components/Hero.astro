---
import PageHero from './PageHero.astro';
---

<!-- La portada rota por los cuatro agentes que mandan: el pulpo que orquesta
     y los tres pilares. Es la misma cabecera que el resto de la web. -->
<PageHero
  portada
  eyebrow="Agentes de IA · supervisión humana"
  titulo="Tu máquina de adquisición, operada por agentes de IA"
  entradilla="No vendemos horas. Construimos el sistema que capta, convierte y mide, y lo operamos con agentes supervisados por nosotros dos, todos los días."
  figuras={['pulpo', 'halcon', 'abeja', 'hormiga']}
>
  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href="/#contacto" class="btn btn-primary">
      Agenda una llamada
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
      </svg>
    </a>
    <a href="/#agentes" class="btn btn-ghost">Ver el sistema por dentro</a>
  </div>
</PageHero>
