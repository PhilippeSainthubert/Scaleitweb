---
/**
 * Cielo de fondo para las secciones de noche.
 *
 * Estrellas deterministas (la semilla decide el reparto, así cada sección
 * tiene su cielo y no cambia entre visitas), unas pocas que titilan despacio
 * y, entre las más cercanas, la misma red tenue de la cabecera. Es SVG
 * estático con una animación de opacidad en CSS: no hay bucle de JavaScript.
 */
interface Props {
  semilla?: number;
  densidad?: number;
  /** El resplandor de horizonte. Se quita donde una sección de noche sigue a otra. */
  brillo?: boolean;
}
const { semilla = 1, densidad = 1, brillo = true } = Astro.props;

function generador(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const azar = generador(semilla * 7919);
const W = 1600;
const H = 1000;
const estrellas = Array.from({ length: Math.round(170 * densidad) }, (_, i) => ({
  x: azar() * W,
  y: azar() * H,
  r: 0.4 + azar() ** 3 * 1.5,
  o: 0.18 + azar() * 0.6,
  titila: i % 9 === 0,
  d: (azar() * 6).toFixed(2),
  dur: (4 + azar() * 5).toFixed(2),
}));
const lineas: string[] = [];
for (let i = 0; i < estrellas.length; i++) {
  for (let j = i + 1; j < estrellas.length; j++) {
    const d = Math.hypot(estrellas[i].x - estrellas[j].x, estrellas[i].y - estrellas[j].y);
    if (d < 80) {
      lineas.push(
        `M${estrellas[i].x.toFixed(1)} ${estrellas[i].y.toFixed(1)}L${estrellas[j].x.toFixed(1)} ${estrellas[j].y.toFixed(1)}`
      );
    }
  }
}
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  {brillo && <div class="noche-brillo"></div>}
  <svg class="absolute inset-0 h-full w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <path d={lineas.join('')} stroke="#5c86ff" stroke-opacity="0.09" stroke-width="0.8" fill="none" />
    {estrellas.map((e) => (
      <circle
        cx={e.x.toFixed(1)}
        cy={e.y.toFixed(1)}
        r={e.r.toFixed(2)}
        fill="#dbe5ff"
        opacity={e.o.toFixed(2)}
        class={e.titila ? 'estrella-titila' : undefined}
        style={e.titila ? `--o:${e.o.toFixed(2)};--d:${e.d}s;--dur:${e.dur}s` : undefined}
      />
    ))}
  </svg>
</div>
