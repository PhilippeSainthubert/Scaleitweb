---
/**
 * Preguntas que se abren con movimiento.
 *
 * Sigue siendo <details>: sin JavaScript abre y cierra igual, el buscador lee
 * todas las respuestas y el teclado funciona sin hacer nada. El script solo
 * anima la altura al abrir y al cerrar, y respeta el movimiento reducido.
 */
interface Props {
  preguntas: { q: string; a: string }[];
}
const { preguntas } = Astro.props;
---

<div class="acordeon" data-acordeon>
  {preguntas.map((f) => (
    <details class="acordeon-item">
      <summary class="acordeon-pregunta">
        <span>{f.q}</span>
        <span class="acordeon-signo" aria-hidden="true"></span>
      </summary>
      <div class="acordeon-cuerpo">
        <p>{f.a}</p>
      </div>
    </details>
  ))}
</div>

<script>
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLDetailsElement>('[data-acordeon] details').forEach((d) => {
    const resumen = d.querySelector('summary')!;
    const cuerpo = d.querySelector<HTMLElement>('.acordeon-cuerpo')!;
    let animacion: Animation | null = null;

    resumen.addEventListener('click', (e) => {
      if (reducido) return;
      e.preventDefault();
      animacion?.cancel();
      const desde = d.offsetHeight;
      if (!d.open) {
        d.open = true;
        const hasta = d.offsetHeight;
        animacion = d.animate({ height: [`${desde}px`, `${hasta}px`] }, { duration: 420, easing: 'cubic-bezier(.16, 1, .3, 1)' });
        cuerpo.animate({ opacity: [0, 1], transform: ['translateY(-6px)', 'none'] }, { duration: 420, easing: 'ease-out' });
      } else {
        d.dataset.cerrando = '';
        const hasta = resumen.offsetHeight;
        animacion = d.animate({ height: [`${desde}px`, `${hasta}px`] }, { duration: 320, easing: 'cubic-bezier(.45, 0, .2, 1)' });
        animacion.onfinish = () => { d.open = false; delete d.dataset.cerrando; };
      }
      animacion.addEventListener('cancel', () => delete d.dataset.cerrando);
    });
  });
</script>
