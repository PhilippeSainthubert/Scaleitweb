---
/**
 * Las cuatro fases, como un recorrido que se dibuja al bajar.
 *
 * La numeración aquí sí dice algo: es un orden real y cada fase depende de la
 * anterior. La línea avanza con el scroll y cada fase se enciende cuando la
 * alcanza; las estrellas crecen de una fase a la siguiente porque el sistema
 * también crece.
 *
 * Sin JavaScript (o con movimiento reducido) la línea se ve entera y todas las
 * fases encendidas.
 */
const fases = [
  {
    nombre: 'Blueprint',
    cuando: 'Semanas 1–2',
    precio: 'Precio fijo',
    texto:
      'Auditamos funnel, stack, datos y equipo. Salís con la arquitectura del sistema, las prioridades y el plan, sea con nosotros o sin nosotros.',
    sale: 'Arquitectura, prioridades y plan',
  },
  {
    nombre: 'Build Sprint',
    cuando: 'Semanas 3–8',
    precio: 'Precio fijo',
    texto:
      'Construimos: CRM y RevOps, tracking y atribución, secuencias de outbound, base de SEO y los agentes que van a operarlo todo.',
    sale: 'El sistema montado y los agentes en marcha',
  },
  {
    nombre: 'Operación',
    cuando: 'Mensual',
    precio: 'Retainer',
    texto:
      'Los agentes ejecutan a diario y nosotros supervisamos cada entrega. Reunión semanal, panel abierto y decisiones sobre datos.',
    sale: 'Trabajo entregado cada semana, revisado',
  },
  {
    nombre: 'Escala',
    cuando: 'Continuo',
    precio: 'Incluido',
    texto:
      'Se dobla lo que funciona y se corta lo que no. Cada mes entran más procesos al sistema y sale más trabajo manual.',
    sale: 'Más procesos dentro, menos trabajo a mano',
  },
];
---

<section id="proceso" class="border-t border-line py-28 sm:py-36">
  <div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-32" data-revelar-grupo>
        <p class="eyebrow">Proceso</p>
        <h2 class="display-lg mt-4 text-balance">De cero a máquina de adquisición</h2>
        <p class="lede mt-5">
          Cuatro fases, cada una con entregable propio. Podés bajarte en cualquiera:
          lo construido es tuyo y queda documentado.
        </p>
        <a href="/precios" class="btn btn-ghost mt-8">
          Ver precios por fase
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <ol class="recorrido lg:col-span-7 lg:col-start-6" data-recorrido-fases>
      <span class="recorrido-via" aria-hidden="true"><span class="recorrido-avance"></span></span>
      {fases.map((f, i) => (
        <li class="fase" data-fase-paso style={`--tam:${10 + i * 3}px`}>
          <span class="fase-estrella" aria-hidden="true"></span>
          <p class="fase-meta">
            <span class="text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span>{f.cuando}</span>
            <span aria-hidden="true">·</span>
            <span>{f.precio}</span>
          </p>
          <h3 class="fase-nombre">{f.nombre}</h3>
          <p class="mt-4 max-w-[52ch] text-[16px] leading-relaxed text-ink-2">{f.texto}</p>
          <p class="fase-sale">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-3">Sale</span>
            {f.sale}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // La línea sigue al scroll: avanza cuando el centro de la pantalla recorre
  // la lista, y cada fase se enciende al quedar por encima de ese punto.
  document.querySelectorAll<HTMLElement>('[data-recorrido-fases]').forEach((lista) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const pasos = Array.from(lista.querySelectorAll<HTMLElement>('[data-fase-paso]'));
    lista.dataset.vivo = '';
    let pendiente = false;

    const actualizar = () => {
      pendiente = false;
      const r = lista.getBoundingClientRect();
      const foco = window.innerHeight * 0.62;
      const avance = Math.min(1, Math.max(0, (foco - r.top) / r.height));
      lista.style.setProperty('--avance', avance.toFixed(4));
      pasos.forEach((p) => {
        const top = p.getBoundingClientRect().top + 14;
        p.toggleAttribute('data-alcanzada', top < foco);
      });
    };

    const alScroll = () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); }
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) window.addEventListener('scroll', alScroll, { passive: true });
      else window.removeEventListener('scroll', alScroll);
      actualizar();
    }, { rootMargin: '20% 0px' }).observe(lista);
  });
</script>
