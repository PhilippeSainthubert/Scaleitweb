---
const steps = [
  {
    number: '01',
    name: 'Blueprint',
    duration: 'Semanas 1–2',
    price: 'Precio fijo',
    description:
      'Auditamos funnel, stack, datos y equipo. Salís con la arquitectura del sistema, las prioridades y el plan — sea con nosotros o sin nosotros.',
  },
  {
    number: '02',
    name: 'Build Sprint',
    duration: 'Semanas 3–8',
    price: 'Precio fijo',
    description:
      'Construimos: CRM y RevOps, tracking y atribución, secuencias de outbound, base de SEO y los agentes que van a operarlo todo.',
  },
  {
    number: '03',
    name: 'Operación',
    duration: 'Mensual',
    price: 'Retainer',
    description:
      'Los agentes ejecutan a diario y nosotros supervisamos cada entrega. Reunión semanal, panel abierto y decisiones sobre datos.',
  },
  {
    number: '04',
    name: 'Escala',
    duration: 'Continuo',
    price: 'Incluido',
    description:
      'Se dobla lo que funciona y se corta lo que no. Cada mes entran más procesos al sistema y sale más trabajo manual.',
  },
];
---

<section id="proceso" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Proceso</p>
      <h2 class="display-lg mt-4 text-balance">De cero a máquina de adquisición</h2>
      <p class="lede mt-5">
        Cuatro fases, cada una con entregable propio. Podés bajarte en cualquiera:
        lo construido es tuyo y queda documentado.
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div class="reveal bg-bg p-7" style={`transition-delay:${i * 70}ms`}>
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] text-accent">{step.number}</span>
            <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-3">{step.price}</span>
          </div>
          <h3 class="mt-5 text-[19px] font-semibold tracking-[-0.02em] text-ink">{step.name}</h3>
          <p class="mt-1 font-mono text-[11px] text-ink-3">{step.duration}</p>
          <p class="mt-4 text-[14px] leading-relaxed text-ink-2">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
