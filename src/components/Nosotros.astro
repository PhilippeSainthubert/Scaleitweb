---
// ⚠️ PENDIENTE: sustituir los datos del segundo socio cuando Philippe los pase.
// Todo lo marcado con «PENDIENTE» es marcador, no dato real.
const socios = [
  {
    nombre: 'Philippe Saint-Hubert',
    rol: 'Sistemas, estrategia y agentes',
    foto: '/philippe.jpeg',
    bio: 'Consultor de growth para empresas tech y fintech. Diseña la arquitectura del sistema y construye los agentes que lo operan.',
    tags: ['Growth strategy', 'Agentes de IA', 'RevOps', 'SEO', 'Fintech'],
    linkedin: 'https://www.linkedin.com/in/philippesainthubert/',
    pendiente: false,
  },
  {
    nombre: 'PENDIENTE — nombre del socio',
    rol: 'Outbound y generación de demanda',
    foto: null,
    bio: 'PENDIENTE — bio real. Especialista en outbound B2B: definición de ICP, señales de compra, secuencias multicanal y deliverability.',
    tags: ['Outbound B2B', 'ICP y datos', 'LinkedIn', 'Deliverability'],
    linkedin: null,
    pendiente: true,
  },
];
---

<section id="nosotros" class="border-t border-line bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Nosotros</p>
      <h2 class="display-lg mt-4 text-balance">Somos dos hermanos, y los vas a tener a los dos</h2>
      <p class="lede mt-5">
        Sin cuentas delegadas en un junior ni gestores que rotan. Uno diseña y
        construye el sistema, el otro lo llena de demanda. Nos conocés por nombre
        desde la primera llamada.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {socios.map((socio, i) => (
        <article class="card reveal p-7" style={`transition-delay:${i * 80}ms`}>
          <div class="flex items-center gap-4">
            {socio.foto ? (
              <img
                src={socio.foto}
                alt={socio.nombre}
                width="64"
                height="64"
                loading="lazy"
                class="h-16 w-16 rounded-full object-cover"
              />
            ) : (
              <div class="flex h-16 w-16 items-center justify-center rounded-full border border-dashed border-line-2 bg-surface font-mono text-[10px] text-ink-3">
                foto
              </div>
            )}
            <div>
              <h3 class="text-[18px] font-semibold tracking-[-0.02em] text-ink">{socio.nombre}</h3>
              <p class="mt-0.5 text-[14px] text-accent">{socio.rol}</p>
            </div>
          </div>

          <p class="mt-6 text-[14.5px] leading-relaxed text-ink-2">{socio.bio}</p>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {socio.tags.map((tag) => (
              <span class="rounded-full border border-line bg-bg px-2.5 py-1 font-mono text-[11px] text-ink-3">{tag}</span>
            ))}
          </div>

          {socio.linkedin && (
            <a href={socio.linkedin} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-1.5 text-[14px] text-ink transition-colors hover:text-accent">
              LinkedIn
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H9m8 0v8" />
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
