---
/**
 * Logo: el símbolo de constelación y el nombre.
 *
 * El símbolo ya existía como favicon, pero la barra enseñaba solo "Scale It"
 * en texto y la marca no tenía cara fuera de la pestaña del navegador. Es el
 * mismo dibujo, para que pestaña, barra y pie digan lo mismo.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" class="shrink-0">
    <rect width="32" height="32" rx="7.5" fill="#0A1628" />
    <g stroke="#5C86FF" stroke-width="1.5" stroke-linecap="round" opacity="0.85">
      <path d="M10 21.5 L9.5 11" />
      <path d="M9.5 11 L21 8.5" />
      <path d="M10 21.5 L22 19" />
      <path d="M9.5 11 L22 19" />
      <path d="M21 8.5 L22 19" />
    </g>
    <circle cx="9.5" cy="11" r="3.1" fill="#2F5CFF" />
    <circle cx="21" cy="8.5" r="2.3" fill="#93B1FF" />
    <circle cx="22" cy="19" r="2.6" fill="#FFFFFF" />
    <circle cx="10" cy="21.5" r="2.1" fill="#93B1FF" />
  </svg>
  <span class="text-[17px] font-semibold tracking-[-0.02em] text-ink">Scale It</span>
</span>
