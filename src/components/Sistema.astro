---
/**
 * El sistema: tres pilares, cada uno con su equipo de agentes.
 *
 * Mismo lenguaje que la app de "Cómo funciona": fondo claro, una ventana de
 * producto y avatares de color. Arriba se elige el pilar (pasan solos mientras
 * la sección está en pantalla); en la ventana, a la izquierda el pilar con su
 * agente jefe y a la derecha los agentes que trabajan para él, cada uno con lo
 * que está haciendo ahora mismo. Cada tarjeta lleva a su servicio.
 *
 * En móvil no hay pestañas: los tres pilares van apilados. Sin JavaScript se
 * ve el primero en escritorio y los tres en móvil.
 */
import Avatar from './Avatar.astro';

const pilares = [
  {
    clave: 'halcon',
    titulo: 'Captar',
    agente: 'Halcón',
    lema: 'Demanda que sale a buscarse.',
    texto:
      'Outbound multicanal construido sobre señales reales de compra, no sobre listas compradas. Secuencias de email y LinkedIn, campañas de pago e influencers cuando el canal lo pide.',
    agentes: [
      { nombre: 'Outbound B2B', animal: 'lobo', href: '/servicios/outbound', rol: 'Escribe a cuentas con motivo', estados: ['38 cuentas con señal de compra hoy', 'Secuencia de 5 correos en revisión', '6 respuestas positivas esta semana'] },
      { nombre: 'LinkedIn', animal: 'cuervo', href: '/servicios/outbound', rol: 'Abre conversaciones en tu nombre', estados: ['12 conversaciones abiertas', '40 perfiles con intención detectada', 'Invitaciones al 38 % de aceptación'] },
      { nombre: 'Paid', animal: 'tiburon', href: '/servicios/paid', rol: 'Lanza y ajusta campañas', estados: ['3 variantes de anuncio en prueba', 'Pujas ajustadas en LinkedIn Ads', 'Coste por lead −18 % este mes'] },
      { nombre: 'Influencers', animal: 'pavoreal', href: '/servicios/influencers', rol: 'Encuentra y briefea creadores', estados: ['12 creadores fintech preseleccionados', 'Brief listo para 3 creadores', '2 colaboraciones cerradas'] },
    ],
  },
  {
    clave: 'abeja',
    titulo: 'Atraer',
    agente: 'Abeja',
    lema: 'Demanda que llega sola.',
    texto:
      'SEO técnico y de contenido pensado para escalar: arquitectura, clusters, contenido programático y presencia en los buscadores con IA, que ya son la primera parada de tus compradores.',
    agentes: [
      { nombre: 'SEO técnico', animal: 'arana', href: '/servicios/seo', rol: 'Arquitectura, clusters e indexación', estados: ['412 URLs auditadas', '27 errores de indexación corregidos', 'Cluster de pagos B2B enlazado'] },
      { nombre: 'Contenido', animal: 'castor', href: '/servicios/seo', rol: 'Artículos y posts en tu voz', estados: ['Artículo 2 de 4 en borrador', '4 posts de LinkedIn listos', 'Guía descargable en maquetación'] },
      { nombre: 'Buscadores con IA', animal: 'buho', href: '/servicios/seo', rol: 'Que ChatGPT y Gemini te citen', estados: ['18 respuestas de IA auditadas', 'Citado en 4 de 10 preguntas clave', 'Ficha de marca enviada a 6 fuentes'] },
    ],
  },
  {
    clave: 'hormiga',
    titulo: 'Operar',
    agente: 'Hormiga',
    lema: 'El sistema que sostiene las dos.',
    texto:
      'Agentes de IA a medida que ejecutan el trabajo repetitivo, conectados a tu CRM y a tus datos. Con supervisión humana en cada entrega y trazabilidad de punta a punta.',
    agentes: [
      { nombre: 'CRM y RevOps', animal: 'elefante', href: '/servicios/revops-crm', rol: 'Pipeline limpio y scoring', estados: ['Scoring v1 con 900 cuentas', '214 duplicados fuera del CRM', 'Etapas del pipeline redefinidas'] },
      { nombre: 'Datos y atribución', animal: 'libelula', href: '/servicios/revops-crm', rol: 'Qué canal trae negocio', estados: ['Panel de atribución conectado', 'Informe semanal enviado', 'UTMs normalizadas en 9 campañas'] },
      { nombre: 'Automatización', animal: 'escarabajo', href: '/servicios/agentes-de-ia', rol: 'El trabajo repetitivo, solo', estados: ['Flujo de alta de leads en pruebas', '3 h al día ahorradas al equipo', 'Cualificación automática activa'] },
    ],
  },
] as const;
---

<section id="servicios" class="noche py-28 sm:py-36" data-sistema>
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-revelar-grupo>
      <p class="eyebrow">El sistema</p>
      <h2 class="display-lg mt-4 text-balance">Tres pilares, un solo sistema</h2>
      <p class="lede mt-5 text-pretty">
        No es un catálogo de servicios sueltos. Es una máquina con tres partes que se
        alimentan entre sí, y cada una la opera su equipo de agentes.
      </p>
    </div>

    <!-- Pestañas: solo en escritorio -->
    <div class="sis-pestanas mt-12" role="tablist" aria-label="Pilares del sistema">
      {pilares.map((p, i) => (
        <button type="button" role="tab" class="sis-pestana" data-sis-ir={i} aria-selected={i === 0 ? 'true' : 'false'}>
          <span class="sis-pestana-relleno" aria-hidden="true"></span>
          <Avatar animal={p.clave} tam={24} />
          {p.titulo}
          <span class="sis-pestana-n">{p.agentes.length}</span>
        </button>
      ))}
    </div>

    <div class="sis-paneles">
      {pilares.map((p, i) => (
        <article class="sis-panel" data-sis-panel={i} data-activo={i === 0 ? '' : undefined}>
          <div class="sis-pilar">
            <div class="sis-pilar-cab">
              <Avatar animal={p.clave} tam={56} />
              <span class="sis-pilar-equipo" aria-hidden="true">
                {p.agentes.map((a) => <Avatar animal={a.animal} tam={26} />)}
              </span>
            </div>
            <p class="sis-pilar-agente">Agente {p.agente} · {p.agentes.length} agentes</p>
            <h3 class="sis-pilar-titulo">{p.titulo}</h3>
            <p class="sis-pilar-lema">{p.lema}</p>
            <p class="sis-pilar-texto">{p.texto}</p>
          </div>
          <ul class="sis-agentes">
            {p.agentes.map((a, j) => (
              <li>
                <a href={a.href} class="sis-agente" style={`--d:${j * 0.7}s`}>
                  <span class="sis-agente-cab">
                    <Avatar animal={a.animal} tam={36} />
                    <span class="min-w-0">
                      <span class="sis-agente-nombre">{a.nombre}</span>
                      <span class="sis-agente-rol">{a.rol}</span>
                    </span>
                    <svg class="sis-agente-flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                  </span>
                  <span class="sis-agente-estado" data-sis-estados={JSON.stringify(a.estados)}>
                    <i aria-hidden="true"></i><span data-sis-texto>{a.estados[0]}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Pestañas que pasan solas mientras la sección se ve, y estados que rotan.
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 7000;

  document.querySelectorAll<HTMLElement>('[data-sistema]').forEach((seccion) => {
    const pestanas = Array.from(seccion.querySelectorAll<HTMLButtonElement>('[data-sis-ir]'));
    const paneles = Array.from(seccion.querySelectorAll<HTMLElement>('[data-sis-panel]'));
    let actual = 0;
    let auto = !reducido;
    let visible = false;
    let temporizador = 0;

    const ir = (i: number) => {
      actual = i;
      window.clearTimeout(temporizador);
      paneles.forEach((p, k) => p.toggleAttribute('data-activo', k === i));
      pestanas.forEach((b, k) => {
        b.setAttribute('aria-selected', k === i ? 'true' : 'false');
        b.removeAttribute('data-corre');
      });
      void seccion.offsetWidth;
      if (auto && visible) {
        pestanas[i]?.setAttribute('data-corre', '');
        temporizador = window.setTimeout(() => ir((i + 1) % paneles.length), DUR);
      }
    };
    pestanas.forEach((b, k) => b.addEventListener('click', () => { auto = false; ir(k); }));

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) ir(actual);
      else window.clearTimeout(temporizador);
    }, { threshold: 0.35 }).observe(seccion);

    // Cada agente va contando lo que hace, a su ritmo.
    if (reducido) return;
    seccion.querySelectorAll<HTMLElement>('[data-sis-estados]').forEach((el, n) => {
      const estados: string[] = JSON.parse(el.dataset.sisEstados || '[]');
      const t = el.querySelector<HTMLElement>('[data-sis-texto]');
      if (!t || estados.length < 2) return;
      let k = 0;
      window.setTimeout(() => window.setInterval(() => {
        if (!visible) return;
        k = (k + 1) % estados.length;
        el.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(-3px)' }], { duration: 220, easing: 'ease-in' }).onfinish = () => {
          t.textContent = estados[k];
          el.animate([{ opacity: 0, transform: 'translateY(3px)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.16, 1, .3, 1)' });
        };
      }, 3600), (n % 4) * 700);
    });
  });
</script>
