---
/**
 * El sistema, contado de noche y dirigido por el scroll.
 *
 * En escritorio la sección se queda fija mientras se baja: la red viva dibuja
 * en grande al agente de cada pilar (halcón, abeja, hormiga) y al lado cambia
 * el texto con los agentes que trabajan para él. Es el momento en que la web
 * enseña la máquina por dentro, y por eso va de noche.
 *
 * En móvil no hay sección fija (en pantallas táctiles el scroll secuestrado se
 * siente roto): los tres pilares van apilados y cada constelación se dibuja al
 * llegar.
 */
import RedAgente from './RedAgente.astro';
import FiguraSVG from './FiguraSVG.astro';
import Constelacion from './Constelacion.astro';
import CieloEstrellado from './CieloEstrellado.astro';

const pilares = [
  {
    clave: 'halcon',
    titulo: 'Captar',
    agente: 'Halcón',
    lema: 'Demanda que sale a buscarse.',
    texto:
      'Outbound multicanal construido sobre señales reales de compra, no sobre listas compradas. Secuencias de email y LinkedIn, campañas de pago e influencers cuando el canal lo pide.',
    agentes: [
      { nombre: 'Outbound B2B', animal: 'lobo', href: '/servicios/outbound' },
      { nombre: 'LinkedIn', animal: 'cuervo', href: '/servicios/outbound' },
      { nombre: 'Paid', animal: 'tiburon', href: '/servicios/paid' },
      { nombre: 'Influencers', animal: 'pavoreal', href: '/servicios/influencers' },
    ],
  },
  {
    clave: 'abeja',
    titulo: 'Atraer',
    agente: 'Abeja',
    lema: 'Demanda que llega sola.',
    texto:
      'SEO técnico y de contenido pensado para escalar: arquitectura, clusters, contenido programático y presencia en los buscadores con IA, que ya son la primera parada de tus compradores.',
    agentes: [
      { nombre: 'SEO técnico', animal: 'arana', href: '/servicios/seo' },
      { nombre: 'Contenido', animal: 'castor', href: '/servicios/seo' },
      { nombre: 'Buscadores con IA', animal: 'buho', href: '/servicios/seo' },
    ],
  },
  {
    clave: 'hormiga',
    titulo: 'Operar',
    agente: 'Hormiga',
    lema: 'El sistema que sostiene las dos.',
    texto:
      'Agentes de IA a medida que ejecutan el trabajo repetitivo, conectados a tu CRM y a tus datos. Con supervisión humana en cada entrega y trazabilidad de punta a punta.',
    agentes: [
      { nombre: 'CRM y RevOps', animal: 'elefante', href: '/servicios/revops-crm' },
      { nombre: 'Datos y atribución', animal: 'libelula', href: '/servicios/revops-crm' },
      { nombre: 'Automatización', animal: 'escarabajo', href: '/servicios/agentes-de-ia' },
    ],
  },
] as const;
---

<section id="servicios" class="noche" data-sistema>
  <CieloEstrellado semilla={3} />

  <div class="mx-auto max-w-6xl px-6 pt-28 sm:pt-36">
    <div class="max-w-2xl" data-revelar-grupo>
      <p class="eyebrow">El sistema</p>
      <h2 class="display-lg mt-4 text-balance">Tres pilares, un solo sistema</h2>
      <p class="lede mt-5">
        No es un catálogo de servicios sueltos. Es una máquina con tres partes que se
        alimentan entre sí, y cada una la opera su agente.
      </p>
    </div>
  </div>

  <!-- Escritorio: la sección se queda fija y el scroll recorre los pilares -->
  <div class="relative hidden lg:block" style={`height:${pilares.length * 100 + 40}vh`} data-recorrido>
    <div class="sticky top-0 flex h-screen items-center overflow-hidden" data-red-raiz>
      <RedAgente figuras={pilares.map((p) => p.clave)} tema="noche" auto={false} class="absolute inset-0" />

      <div class="relative mx-auto grid w-full max-w-6xl grid-cols-12 items-center gap-8 px-6">
        <!-- Raíl de progreso -->
        <ol class="col-span-1 flex flex-col gap-8 self-center" aria-label="Pilares">
          {pilares.map((p, i) => (
            <li class="rail-paso" data-paso={i}>
              <span class="rail-punto"></span>
              <span class="rail-nombre">{p.titulo}</span>
            </li>
          ))}
        </ol>

        <!-- Textos: uno visible a la vez -->
        <div class="relative col-span-5 min-h-[30rem]">
          {pilares.map((p, i) => (
            <article class="pilar-panel" data-panel={i} data-estado={i === 0 ? 'activo' : 'despues'}>
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">
                Agente {p.agente}
              </p>
              <h3 class="mt-4 text-[clamp(2.6rem,1.6rem+3vw,4.25rem)] font-semibold leading-[1] tracking-[-0.04em] text-ink">
                {p.titulo}
              </h3>
              <p class="mt-4 text-[19px] font-medium text-accent-deep">{p.lema}</p>
              <p class="mt-5 max-w-[46ch] text-[16px] leading-relaxed text-ink-2">{p.texto}</p>
              <ul class="mt-8 grid grid-cols-2 gap-2.5">
                {p.agentes.map((a) => (
                  <li>
                    <a href={a.href} class="agente-chip">
                      <Constelacion animal={a.animal} size={24} claro />
                      <span>{a.nombre}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="col-span-6">
          <div data-figura-hueco class="mx-auto aspect-square w-full max-w-[540px]"></div>
          <p data-figura-leyenda class="figura-leyenda mt-2 flex justify-center">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            <span data-figura-nombre class="text-ink">{pilares[0].agente}</span>
            <span aria-hidden="true">·</span>
            <span data-figura-rol>Agente de captación</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Móvil y tableta: los tres pilares apilados -->
  <div class="mx-auto max-w-6xl space-y-24 px-6 pb-28 pt-16 lg:hidden">
    {pilares.map((p) => (
      <article>
        <FiguraSVG animal={p.clave} tema="noche" class="mx-auto w-[min(78vw,340px)]" />
        <div data-revelar-grupo>
          <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.16em] text-accent">Agente {p.agente}</p>
          <h3 class="mt-3 text-[2.6rem] font-semibold leading-none tracking-[-0.04em] text-ink">{p.titulo}</h3>
          <p class="mt-3 text-[18px] font-medium text-accent-deep">{p.lema}</p>
          <p class="mt-4 text-[15.5px] leading-relaxed text-ink-2">{p.texto}</p>
          <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
            {p.agentes.map((a) => (
              <li>
                <a href={a.href} class="agente-chip">
                  <Constelacion animal={a.animal} size={24} claro />
                  <span>{a.nombre}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // El scroll decide qué pilar se ve: progreso dentro del recorrido fijo.
  document.querySelectorAll<HTMLElement>('[data-sistema]').forEach((seccion) => {
    const recorrido = seccion.querySelector<HTMLElement>('[data-recorrido]');
    const canvas = seccion.querySelector<HTMLCanvasElement>('canvas[data-red-agente]');
    const paneles = Array.from(seccion.querySelectorAll<HTMLElement>('[data-panel]'));
    const pasos = Array.from(seccion.querySelectorAll<HTMLElement>('[data-paso]'));
    if (!recorrido || !canvas || !paneles.length) return;

    let actual = 0;
    let pendiente = false;

    const actualizar = () => {
      pendiente = false;
      const r = recorrido.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const progreso = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      const i = Math.min(paneles.length - 1, Math.floor(progreso * paneles.length));
      seccion.style.setProperty('--progreso', progreso.toFixed(4));
      if (i === actual) return;
      actual = i;
      paneles.forEach((p, k) => p.setAttribute('data-estado', k === i ? 'activo' : k < i ? 'antes' : 'despues'));
      pasos.forEach((p, k) => { p.toggleAttribute('data-hecho', k <= i); p.toggleAttribute('data-actual', k === i); });
      canvas.dispatchEvent(new CustomEvent('figura:ir', { detail: i }));
    };

    pasos.forEach((p, k) => { p.toggleAttribute('data-hecho', k === 0); p.toggleAttribute('data-actual', k === 0); });
    window.addEventListener('scroll', () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); }
    }, { passive: true });
    actualizar();
  });
</script>
