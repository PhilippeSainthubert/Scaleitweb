---
/**
 * Organigrama de agentes, animado.
 *
 * Cuenta el argumento entero de la casa: un orquestador reparte, los
 * especialistas derivan el trabajo en subagentes que se ejecutan en paralelo,
 * y las DOCE ramas convergen en un único punto que es una persona.
 *
 * Esa convergencia es deliberada, visual y conceptualmente: doce hilos
 * entrando en un solo nodo es lo que explica por qué la revisión humana no es
 * un adorno del discurso, es el cuello de botella del sistema.
 *
 * SVG con viewBox para que escale sin perder nitidez, animado solo con CSS.
 * En móvil se sustituye por una versión apilada: un grafo de cuatro columnas
 * a 360 px no se lee.
 */

const W = 1200;
const H = 700;

const objetivo = { x: 600, y: 44 };
const orq = { x: 600, y: 158 };
const revision = { x: 600, y: 540 };
const salida = { x: 600, y: 650 };

const ESP_Y = 300;
const SUB_Y = 410;

const especialistas = [
  { x: 158, nombre: 'Investigación', sub: ['ICP', 'Señales', 'Enriquece'] },
  { x: 452, nombre: 'Contenido', sub: ['Research', 'Redacta', 'Visual'] },
  { x: 748, nombre: 'Outbound', sub: ['Listas', 'Copy', 'Envíos'] },
  { x: 1042, nombre: 'Datos', sub: ['CRM', 'Atribuye', 'Panel'] },
];

/** Curva en S vertical entre dos puntos. */
const curva = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const dy = (b.y - a.y) * 0.5;
  return `M${a.x},${a.y} C${a.x},${a.y + dy} ${b.x},${b.y - dy} ${b.x},${b.y}`;
};
const largo = (a: { x: number; y: number }, b: { x: number; y: number }) =>
  Math.round(Math.hypot(b.x - a.x, b.y - a.y) * 1.2);

const ESP_W = 190;
const ESP_H = 62;
const ORQ_W = 300;
const ORQ_H = 84;
const REV_W = 486;
const REV_H = 96;
const SUB_H = 30;
const anchoPildora = (t: string) => Math.max(58, t.length * 6.2 + 22);

// Posición de cada subagente
const subs = especialistas.flatMap((e, i) =>
  e.sub.map((s, j) => ({
    x: e.x + (j - 1) * 78,
    y: SUB_Y,
    etiqueta: s,
    w: anchoPildora(s),
    padre: { x: e.x, y: ESP_Y + ESP_H / 2 },
    indice: i * 3 + j,
  }))
);

const aristas = [
  { d: curva({ x: objetivo.x, y: objetivo.y + 24 }, { x: orq.x, y: orq.y - ORQ_H / 2 }), l: 90, delay: 0, w: 2.6 },
  ...especialistas.map((e, i) => ({
    d: curva({ x: orq.x, y: orq.y + ORQ_H / 2 }, { x: e.x, y: ESP_Y - ESP_H / 2 }),
    l: largo({ x: orq.x, y: orq.y }, { x: e.x, y: ESP_Y }),
    delay: 0.45 + i * 0.12,
    w: 2.4,
  })),
  ...subs.map((s) => ({
    d: curva(s.padre, { x: s.x, y: s.y - SUB_H / 2 }),
    l: largo(s.padre, s),
    delay: 1.0 + s.indice * 0.05,
    w: 1.8,
  })),
  ...subs.map((s) => ({
    d: curva({ x: s.x, y: s.y + SUB_H / 2 }, { x: revision.x, y: revision.y - REV_H / 2 }),
    l: largo(s, revision),
    delay: 1.7 + s.indice * 0.07,
    w: 1.8,
  })),
  { d: curva({ x: revision.x, y: revision.y + REV_H / 2 }, { x: salida.x, y: salida.y - 26 }), l: 80, delay: 3.1, w: 3 },
];

// Puntos de fondo, para que el panel respire como el resto del sitio
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(4711);
const fondo = Array.from({ length: 46 }, () => ({
  x: +(rnd() * W).toFixed(0),
  y: +(rnd() * H).toFixed(0),
  r: +(0.8 + rnd() * 1.4).toFixed(1),
  o: +(0.06 + rnd() * 0.12).toFixed(2),
}));
---

<section class="border-t border-line bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Cómo se reparte el trabajo</p>
      <h2 class="display-lg mt-4 text-balance">Doce agentes trabajando, y una sola puerta de salida</h2>
      <p class="lede mt-5">
        El orquestador reparte, cada especialista deriva en subagentes y todos
        se ejecutan a la vez. Pero las doce ramas terminan en el mismo sitio:
        una persona que lo lee antes de que salga.
      </p>
    </div>

    {/* ── Escritorio ─────────────────────────────────────────────── */}
    <div class="mt-14 hidden sm:block">
      <div class="overflow-hidden rounded-2xl border border-line bg-bg">
        <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Organigrama: el agente orquestador reparte el trabajo a cuatro agentes especialistas, cada uno deriva en tres subagentes, y las doce ramas convergen en una revisión humana antes de entregarse al cliente.">
          <defs>
            <linearGradient id="orgFlujo" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#93b1ff" />
              <stop offset="0.5" stop-color="#2f5cff" />
              <stop offset="1" stop-color="#1633b8" />
            </linearGradient>
            <radialGradient id="orgHalo">
              <stop offset="0" stop-color="#2f5cff" stop-opacity="0.16" />
              <stop offset="1" stop-color="#2f5cff" stop-opacity="0" />
            </radialGradient>
            <clipPath id="av1"><circle cx="0" cy="0" r="17" /></clipPath>
            <clipPath id="av2"><circle cx="0" cy="0" r="17" /></clipPath>
          </defs>

          <rect width={W} height={H} fill="#ffffff" />
          {fondo.map((p) => (
            <circle cx={p.x} cy={p.y} r={p.r} fill="#2f5cff" opacity={p.o} />
          ))}

          {/* Halo bajo la revisión: ahí es donde converge todo */}
          <circle cx={revision.x} cy={revision.y} r="230" fill="url(#orgHalo)" />

          {/* Conexiones */}
          {aristas.map((a) => (
            <path d={a.d} fill="none" stroke="#c8d3e4" stroke-width={a.w * 0.62} />
          ))}
          {aristas.map((a) => (
            <path
              class="org-pulso"
              d={a.d}
              fill="none"
              stroke="url(#orgFlujo)"
              stroke-width={a.w}
              stroke-linecap="round"
              style={`--l:${a.l};--d:${a.delay}s`}
            />
          ))}

          {/* Objetivo */}
          <g>
            <rect x={objetivo.x - 140} y={objetivo.y - 24} width="280" height="48" rx="10" fill="#ffffff" stroke="#e4e9f2" />
            <text x={objetivo.x} y={objetivo.y + 5} text-anchor="middle" class="org-t-nodo" fill="#0a1628">Objetivo del trimestre</text>
          </g>

          {/* Orquestador */}
          <g>
            <rect x={orq.x - ORQ_W / 2} y={orq.y - ORQ_H / 2} width={ORQ_W} height={ORQ_H} rx="14" fill="#0a1628" />
            <circle class="org-latido" cx={orq.x - ORQ_W / 2 + 30} cy={orq.y} r="6" fill="#5C86FF" />
            <text x={orq.x + 14} y={orq.y - 10} text-anchor="middle" class="org-t-mono" fill="#93b1ff">Agente</text>
            <text x={orq.x + 14} y={orq.y + 16} text-anchor="middle" class="org-t-orq" fill="#ffffff">Orquestador</text>
          </g>

          {/* Especialistas */}
          {especialistas.map((e, i) => (
            <g>
              <rect x={e.x - ESP_W / 2} y={ESP_Y - ESP_H / 2} width={ESP_W} height={ESP_H} rx="11" fill="#ffffff" stroke="#e4e9f2" />
              <circle class="org-activo" cx={e.x - ESP_W / 2 + 18} cy={ESP_Y - ESP_H / 2 + 17} r="3.5" fill="#2f5cff" style={`--d:${i * 0.4}s`} />
              <text x={e.x} y={ESP_Y + 6} text-anchor="middle" class="org-t-nodo" fill="#0a1628">{e.nombre}</text>
            </g>
          ))}

          {/* Subagentes */}
          {subs.map((s) => (
            <g>
              <rect class="org-sub" x={s.x - s.w / 2} y={s.y - SUB_H / 2} width={s.w} height={SUB_H} rx={SUB_H / 2} fill="#f4f7fc" stroke="#c8d3e4" stroke-width="1.2" style={`--d:${s.indice * 0.16}s`} />
              <text x={s.x} y={s.y + 4} text-anchor="middle" class="org-t-sub" fill="#42536b">{s.etiqueta}</text>
            </g>
          ))}

          {/* Revisión humana */}
          <g>
            <rect class="org-revision" x={revision.x - REV_W / 2} y={revision.y - REV_H / 2} width={REV_W} height={REV_H} rx="16" fill="#ffffff" stroke="#2f5cff" stroke-width="2" />

            <g transform={`translate(${revision.x - 186}, ${revision.y})`}>
              <circle r="18" fill="#eef3ff" />
              <image href="/philippe.jpeg" x="-17" y="-17" width="34" height="34" clip-path="url(#av1)" preserveAspectRatio="xMidYMid slice" />
            </g>
            <g transform={`translate(${revision.x - 154}, ${revision.y})`}>
              <circle r="18" fill="#eef3ff" stroke="#ffffff" stroke-width="2.5" />
              <image href="/patrick.jpeg" x="-17" y="-17" width="34" height="34" clip-path="url(#av2)" preserveAspectRatio="xMidYMid slice" />
            </g>

            <text x={revision.x + 14} y={revision.y - 8} text-anchor="middle" class="org-t-rev" fill="#0a1628">Revisión humana</text>
            <text x={revision.x + 14} y={revision.y + 16} text-anchor="middle" class="org-t-mono" fill="#2f5cff">Nada sale sin pasar por aquí</text>

            {/* Cola: el trabajo esperando aprobación */}
            <g transform={`translate(${revision.x + REV_W / 2 - 52}, ${revision.y})`}>
              <rect x="-30" y="-15" width="60" height="30" rx="15" fill="#eef3ff" />
              <text x="0" y="4" text-anchor="middle" class="org-t-mono" fill="#1633b8">3 en cola</text>
            </g>
          </g>

          {/* Salida */}
          <g>
            <rect x={salida.x - 130} y={salida.y - 26} width="260" height="52" rx="11" fill="#0f9960" />
            <text x={salida.x} y={salida.y + 5} text-anchor="middle" class="org-t-nodo" fill="#ffffff">Sale al cliente</text>
          </g>
        </svg>
      </div>
    </div>

    {/* ── Móvil ──────────────────────────────────────────────────── */}
    <div class="mt-12 sm:hidden">
      {[
        { t: 'Objetivo del trimestre', s: 'Entra', tipo: 'entrada' },
        { t: 'Agente Orquestador', s: 'Reparte y coordina', tipo: 'orq' },
        { t: '4 especialistas', s: 'Investigación · Contenido · Outbound · Datos', tipo: 'normal' },
        { t: '12 subagentes en paralelo', s: 'Cada especialista deriva en tres', tipo: 'normal' },
        { t: 'Revisión humana', s: 'Nada sale sin pasar por aquí', tipo: 'humano' },
        { t: 'Sale al cliente', s: '', tipo: 'salida' },
      ].map((n, i, arr) => (
        <div>
          <div class={`rounded-xl border p-4 ${
            n.tipo === 'orq' ? 'border-ink bg-ink' :
            n.tipo === 'humano' ? 'border-accent bg-accent/[0.05]' :
            n.tipo === 'salida' ? 'border-positive bg-positive' :
            'border-line bg-bg'
          }`}>
            <p class={`text-[15px] font-semibold ${n.tipo === 'orq' || n.tipo === 'salida' ? 'text-white' : 'text-ink'}`}>{n.t}</p>
            {n.s && (
              <p class={`mt-1 font-mono text-[11.5px] ${
                n.tipo === 'orq' ? 'text-[#93b1ff]' : n.tipo === 'humano' ? 'text-accent' : 'text-ink-3'
              }`}>{n.s}</p>
            )}
          </div>
          {i < arr.length - 1 && (
            <div class="flex justify-center py-1.5">
              <span class="org-flecha h-6 w-px bg-line-2"></span>
            </div>
          )}
        </div>
      ))}
    </div>

    <p class="mt-6 text-[13px] leading-relaxed text-ink-3">
      Los agentes se reparten el trabajo y se ejecutan a la vez. La revisión es
      el único paso que no se automatiza, y es el que responde de lo que sale.
    </p>
  </div>
</section>
