---
/**
 * Cómo corre un trimestre, contado como la app por dentro.
 *
 * Es la pieza central de la web. En vez de un diagrama, se ve el producto:
 * una ventana con los agentes a la izquierda (cada uno con su estado en vivo)
 * y la conversación con el orquestador a la derecha. Philippe y Patrick
 * escriben en el campo de mensaje, el orquestador piensa y contesta con
 * tarjetas: el plan para aprobar, el reparto, el avance de los diez agentes,
 * la cola de revisión (con una entrega devuelta), lo que sale al cliente y la
 * regla que aprende.
 *
 * Seis pasos que se eligen con las pastillas de arriba y se reproducen solos
 * mientras la sección está en pantalla. Al saltar a un paso, lo anterior queda
 * ya escrito en el hilo, como en una conversación real. En móvil se ve solo el
 * hilo. El texto completo está siempre en el DOM para lectores de pantalla y
 * buscadores. Con movimiento reducido cada paso aparece ya terminado.
 */
import { FIGURAS } from '../data/constelaciones';

type Quien = 'philippe' | 'patrick' | 'orq';
const pasos: { corto: string; titulo: string; texto: string; reloj: string; chat: { q: Quien; t: string }[] }[] = [
  {
    corto: 'Objetivo',
    titulo: 'Fijamos el objetivo',
    texto: 'Todo empieza en una persona. Le damos al orquestador el objetivo del trimestre y el contexto que solo tenemos nosotros.',
    reloj: 'Lunes 09:00',
    chat: [
      { q: 'philippe', t: 'Objetivo del trimestre: abrir conversación con fintechs B2B en España. Ticket alto y venta asistida.' },
      { q: 'orq', t: 'Recibido. Leo el contexto y te propongo un plan.' },
    ],
  },
  {
    corto: 'Plan',
    titulo: 'Lo lee y nos propone un plan',
    texto: 'El orquestador lo convierte en un plan por pilares y nos lo devuelve. Hasta que no lo aprobamos, no se mueve nada.',
    reloj: 'Lunes 09:06',
    chat: [
      { q: 'orq', t: 'Leído. Captar escribe a 300 cuentas con señales de compra, Atraer publica cuatro artículos sobre pagos B2B y Operar monta el scoring en el CRM. ¿Arranco?' },
      { q: 'patrick', t: 'Aprobado. En LinkedIn, tono directo y nada de plantillas.' },
    ],
  },
  {
    corto: 'Reparto',
    titulo: 'Reparte el trabajo',
    texto: 'Cada pilar recibe su parte y la baja a sus agentes, con instrucciones y límites escritos.',
    reloj: 'Lunes 10:12',
    chat: [{ q: 'orq', t: 'Enviado: 6 tareas a Captar, 4 a Atraer y 4 a Operar. Cada agente sabe qué no puede tocar.' }],
  },
  {
    corto: 'Ejecución',
    titulo: 'Los agentes ejecutan a la vez',
    texto: 'Diez agentes trabajando en paralelo, cada uno en lo suyo. Lo que a un equipo le lleva semanas, aquí son horas.',
    reloj: 'Lunes 10:13',
    chat: [{ q: 'orq', t: 'Diez agentes en marcha. Aviso en cuanto haya algo para revisar.' }],
  },
  {
    corto: 'Revisión',
    titulo: 'Todo vuelve a nosotros',
    texto: 'Las diez ramas terminan en el mismo sitio. Lo leemos antes de que salga, y lo que no está bien vuelve con un comentario.',
    reloj: 'Martes 08:30',
    chat: [
      { q: 'orq', t: 'Hay seis entregas esperando revisión.' },
      { q: 'patrick', t: 'El asunto del correo 3 suena a plantilla. Rehacelo.' },
      { q: 'orq', t: 'Devuelto a Outbound con tu comentario.' },
    ],
  },
  {
    corto: 'Salida',
    titulo: 'Sale al cliente, y el sistema aprende',
    texto: 'Lo aprobado sale. Lo que corregimos vuelve al orquestador como regla, para no tener que corregirlo dos veces.',
    reloj: 'Martes 11:05',
    chat: [
      { q: 'philippe', t: 'El resto, aprobado.' },
      { q: 'orq', t: 'Enviado al cliente. Y regla nueva para Outbound: asuntos cortos y sin fórmulas.' },
    ],
  },
];
const NOMBRE: Record<Quien, string> = { philippe: 'Philippe', patrick: 'Patrick', orq: 'Orquestador' };

// Los agentes: cada uno con su animal, su color y lo que hace este trimestre.
const pilares = [
  { id: 'captar', nombre: 'Captar', animal: 'halcon', color: '#f97316' },
  { id: 'atraer', nombre: 'Atraer', animal: 'abeja', color: '#10b981' },
  { id: 'operar', nombre: 'Operar', animal: 'hormiga', color: '#7c3aed' },
];
const agentes = [
  { nombre: 'Outbound', animal: 'lobo', color: '#e5484d', pilar: 0, tareas: 2, avance: '120 de 300 cuentas investigadas', ritmo: 5.2 },
  { nombre: 'LinkedIn', animal: 'cuervo', color: '#f2994a', pilar: 0, tareas: 1, avance: '40 perfiles con señal de compra', ritmo: 9.5 },
  { nombre: 'Paid', animal: 'tiburon', color: '#ec4899', pilar: 0, tareas: 2, avance: '3 anuncios en borrador', ritmo: 4.4 },
  { nombre: 'Influencers', animal: 'pavoreal', color: '#f5a524', pilar: 0, tareas: 1, avance: '12 creadores fintech preseleccionados', ritmo: 10.5 },
  { nombre: 'SEO', animal: 'arana', color: '#14b8a6', pilar: 1, tareas: 1, avance: 'Artículo 2 de 4 en borrador', ritmo: 3.8 },
  { nombre: 'Contenido', animal: 'castor', color: '#22c55e', pilar: 1, tareas: 2, avance: '4 posts de LinkedIn en tu voz', ritmo: 5.8 },
  { nombre: 'AEO', animal: 'buho', color: '#0ea5e9', pilar: 1, tareas: 1, avance: '18 respuestas de IA auditadas', ritmo: 9 },
  { nombre: 'CRM', animal: 'elefante', color: '#6366f1', pilar: 2, tareas: 2, avance: 'Scoring v1 con 900 cuentas', ritmo: 4.9 },
  { nombre: 'Datos', animal: 'libelula', color: '#8b5cf6', pilar: 2, tareas: 1, avance: 'Panel de atribución conectado', ritmo: 11 },
  { nombre: 'Automatización', animal: 'escarabajo', color: '#a16207', pilar: 2, tareas: 1, avance: 'Flujo de alta de leads en pruebas', ritmo: 6.2 },
];

// Un avatar: un círculo de color con la constelación del animal en blanco.
const figura = (animal: string) => {
  const f = FIGURAS[animal];
  const lineas = f.e.map(([a, b]) => `<line x1="${f.p[a][0]}" y1="${f.p[a][1]}" x2="${f.p[b][0]}" y2="${f.p[b][1]}"/>`).join('');
  const puntos = f.p.map(([x, y, r]) => `<circle cx="${x}" cy="${y}" r="${r}"/>`).join('');
  return `<svg viewBox="0 0 48 48" aria-hidden="true"><g class="sc-av-lineas">${lineas}</g><g class="sc-av-puntos">${puntos}</g></svg>`;
};
const av = (animal: string, color: string) => `<span class="sc-av" style="--c:${color}">${figura(animal)}</span>`;
const foto = (q: string) => `<span class="sc-av sc-av-foto"><img src="/${q}.jpeg" alt="" width="40" height="40" loading="lazy" decoding="async"></span>`;

const AV: Record<string, string> = {
  orq: av('pulpo', '#2f5cff'),
  philippe: foto('philippe'),
  patrick: foto('patrick'),
  ...Object.fromEntries(pilares.map((p) => [p.id, av(p.animal, p.color)])),
  ...Object.fromEntries(agentes.map((a, k) => [`a${k}`, av(a.animal, a.color)])),
};

const datosGuion = {
  pasos: pasos.map(({ titulo, texto, reloj, chat }) => ({ titulo, texto, reloj, chat })),
  agentes: agentes.map(({ nombre, color, tareas, avance, ritmo }) => ({ nombre, color, tareas, avance, ritmo })),
  av: AV,
};
---

<section id="como-funciona" class="sc-seccion py-28 sm:py-36" data-org>
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-revelar-grupo>
      <p class="eyebrow">Cómo funciona</p>
      <h2 class="display-lg mt-4 text-balance">Diez agentes trabajando, y una sola puerta de salida</h2>
      <p class="lede mt-5 text-pretty">
        Así corre un trimestre de punta a punta. Empieza en nosotros, pasa por el
        orquestador y sus diez agentes, y vuelve a nosotros antes de salir.
      </p>
    </div>

    <!-- El instructivo completo, para lectores de pantalla y buscadores -->
    <ol class="sr-only">
      {pasos.map((p, i) => (
        <li>
          <p>Paso {i + 1}: {p.titulo}. {p.texto}</p>
          {p.chat.map((m) => <p>{NOMBRE[m.q]}: {m.t}</p>)}
        </li>
      ))}
    </ol>

    <div class="sc-reproductor mt-12" data-org-reproductor>
      <!-- Los seis pasos, como pastillas -->
      <div class="sc-pasos-fila">
        <ol class="sc-pasos" aria-label="Pasos del trimestre">
          {pasos.map((p, i) => (
            <li>
              <button type="button" class="sc-paso" data-org-ir={i} aria-label={`Paso ${i + 1}: ${p.titulo}`}>
                <span class="sc-paso-relleno" aria-hidden="true"></span>
                <span class="sc-paso-num">{i + 1}</span>{p.corto}
              </button>
            </li>
          ))}
        </ol>
        <button type="button" class="sc-play" data-org-play aria-label="Pausar">
          <svg class="sc-icono-pausa" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
          <svg class="sc-icono-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" /></svg>
        </button>
      </div>
      <p class="sc-narracion" aria-hidden="true" data-org-narracion>
        <strong data-org-titulo>{pasos[0].titulo}.</strong> <span data-org-texto>{pasos[0].texto}</span>
      </p>

      <!-- La app -->
      <div class="sc-ventana" aria-hidden="true">
        <aside class="sc-lateral">
          <div class="sc-lateral-cab">
            <span class="sc-luces"><i></i><i></i><i></i></span>
            <span class="sc-iconos">
              <span class="sc-icono"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg></span>
              <span class="sc-icono"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
            </span>
          </div>
          <div class="sc-fijos">
            <div class="sc-fijo" data-activo>
              <Fragment set:html={AV.orq} />
              <span>Orquestador</span>
            </div>
            {pilares.map((p) => (
              <div class="sc-fijo">
                <Fragment set:html={AV[p.id]} />
                <span>{p.nombre}</span>
              </div>
            ))}
          </div>
          <ul class="sc-agentes">
            {agentes.map((a, k) => (
              <li class="sc-agente" data-agente={k} data-tono="espera">
                <Fragment set:html={AV[`a${k}`]} />
                <span class="min-w-0">
                  <span class="sc-agente-nombre">{a.nombre}<i class="sc-agente-pilar">{pilares[a.pilar].nombre}</i></span>
                  <span class="sc-agente-estado" data-agente-estado>Esperando instrucciones</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="sc-lateral-pie">
            <span class="sc-pie-avs"><Fragment set:html={AV.philippe} /><Fragment set:html={AV.patrick} /></span>
            Philippe y Patrick
          </div>
        </aside>

        <div class="sc-chat">
          <div class="sc-chat-cab">
            <span class="sc-chat-cab-izq"><span class="sc-luces sc-luces-movil"><i></i><i></i><i></i></span></span>
            <span class="sc-chat-titulo"><Fragment set:html={AV.orq} />Orquestador</span>
            <span class="sc-chat-cab-der"><span class="sc-compartir">Compartir</span></span>
          </div>
          <div class="sc-hilo" data-org-hilo></div>
          <div class="sc-composer" data-org-composer>
            <span class="sc-composer-mas"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span>
            <span class="sc-composer-av" data-composer-av></span>
            <span class="sc-composer-txt" data-composer-txt><span class="sc-composer-ph">Escribile al Orquestador…</span></span>
            <span class="sc-composer-enviar"><svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></svg></span>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" data-org-datos set:html={JSON.stringify(datosGuion)} />
  </div>
</section>

<script>
  /**
   * El guion de la app. Cada paso escribe en el hilo: alguien teclea en el
   * campo de mensaje y lo envía, el orquestador piensa y contesta con una
   * tarjeta, y la lista de agentes cambia de estado. Al saltar a un paso, los
   * anteriores se escriben al instante, ya terminados. Se reproduce solo
   * mientras la sección está en pantalla. Con movimiento reducido todo
   * aparece terminado y no hay reproducción automática.
   */
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = [7600, 10000, 7500, 9000, 12500, 11500];

  type Quien = 'philippe' | 'patrick' | 'orq';
  type Agente = { nombre: string; color: string; tareas: number; avance: string; ritmo: number };
  type Datos = {
    pasos: { titulo: string; texto: string; reloj: string; chat: { q: Quien; t: string }[] }[];
    agentes: Agente[];
    av: Record<string, string>;
  };
  // Lo que entrega cada agente en la revisión, en el orden en que llega.
  const ENTREGAS: [number, string][] = [
    [0, 'Secuencia de 5 correos'], [4, 'Artículo: pagos B2B'], [7, 'Scoring de cuentas'],
    [2, '3 anuncios en LinkedIn'], [5, '4 posts de LinkedIn'], [9, 'Flujo de alta de leads'],
  ];
  const PLAN: [string, string, string][] = [
    ['captar', 'Escribir a 300 cuentas con señales de compra', '6 tareas'],
    ['atraer', 'Cuatro artículos sobre pagos B2B', '4 tareas'],
    ['operar', 'Scoring de cuentas en el CRM', '4 tareas'],
  ];
  const PILARES: Record<string, string> = { captar: 'Captar', atraer: 'Atraer', operar: 'Operar' };
  const T4 = 8; // segundos de ejecución en el paso 4

  document.querySelectorAll<HTMLElement>('[data-org]').forEach((raiz) => {
    const hilo = raiz.querySelector<HTMLElement>('[data-org-hilo]')!;
    const composerAv = raiz.querySelector<HTMLElement>('[data-composer-av]');
    const composerTxt = raiz.querySelector<HTMLElement>('[data-composer-txt]');
    const composer = raiz.querySelector<HTMLElement>('[data-org-composer]');
    const reproductor = raiz.querySelector<HTMLElement>('[data-org-reproductor]')!;
    const narracion = raiz.querySelector<HTMLElement>('[data-org-narracion]');
    const titulo = raiz.querySelector('[data-org-titulo]');
    const texto = raiz.querySelector('[data-org-texto]');
    const botones = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-org-ir]'));
    const btnPlay = raiz.querySelector<HTMLButtonElement>('[data-org-play]');
    const D: Datos = JSON.parse(raiz.querySelector('[data-org-datos]')?.textContent || '{}');
    const NOMBRE: Record<Quien, string> = { philippe: 'Philippe', patrick: 'Patrick', orq: 'Orquestador' };
    const placeholder = composerTxt?.innerHTML || '';

    let actual = -1;
    let reproduciendo = !reducido;
    let visible = false;
    let tiempos: number[] = [];
    let ciclos: number[] = [];
    let instantaneo = false;
    let ahora = 0;          // ms del evento que se está pintando, para la hora
    let minutoBase = 0;

    // Con movimiento reducido, o al reconstruir un paso anterior, todo ocurre ya.
    const en = (ms: number, fn: () => void) => {
      if (reducido || instantaneo) { ahora = ms; fn(); return; }
      tiempos.push(window.setTimeout(() => { ahora = ms; fn(); }, ms));
    };
    const cada = (ms: number, fn: () => void) => {
      if (!reducido && !instantaneo) ciclos.push(window.setInterval(fn, ms));
    };
    const animado = () => !reducido && !instantaneo;

    const el = (html: string) => {
      const t = document.createElement('template');
      t.innerHTML = html.trim();
      return t.content.firstElementChild as HTMLElement;
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const hora = () => {
      const m = minutoBase + Math.floor(ahora / 1000);
      return `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
    };
    const bajar = () => hilo.scrollTo({ top: hilo.scrollHeight, behavior: animado() ? 'smooth' : 'auto' });
    const poner = (nodo: HTMLElement) => {
      if (animado()) nodo.classList.add('sc-entra');
      hilo.appendChild(nodo);
      bajar();
      return nodo;
    };

    // ── Mensajes ──────────────────────────────────────────────────
    function separador(t: string) { poner(el(`<p class="sc-sep"><span>${esc(t)}</span></p>`)); }
    function orq(textoMsg: string, tarjeta?: HTMLElement) {
      const m = el(`<div class="sc-m sc-m-orq">${D.av.orq}<div class="sc-m-cuerpo"><p class="sc-m-quien">Orquestador <time>${hora()}</time></p><p class="sc-burbuja">${esc(textoMsg)}</p></div></div>`);
      if (tarjeta) m.querySelector('.sc-m-cuerpo')!.appendChild(tarjeta);
      poner(m);
      return m;
    }
    function humano(q: Quien, textoMsg: string) {
      poner(el(`<div class="sc-m sc-m-humano"><p class="sc-m-quien"><time>${hora()}</time> ${NOMBRE[q]} ${D.av[q]}</p><p class="sc-burbuja">${esc(textoMsg)}</p></div>`));
    }
    // "Pensando", con los puntos. Solo se ve cuando hay animación.
    function pensar(desde: number, hasta: number) {
      let nodo: HTMLElement | null = null;
      en(desde, () => {
        if (!animado()) return;
        nodo = poner(el(`<div class="sc-pensando">${D.av.orq}<span class="sc-puntos"><i></i><i></i><i></i></span><span class="sc-brillo">Pensando</span></div>`));
      });
      en(hasta, () => nodo?.remove());
    }
    // Alguien escribe en el campo de mensaje y lo envía.
    function escribir(q: Quien, textoMsg: string, ms: number) {
      const dur = Math.min(2400, textoMsg.length * 24);
      en(ms, () => {
        if (!animado() || !composerTxt || !composerAv) return;
        composer?.setAttribute('data-escribiendo', '');
        composerAv.innerHTML = D.av[q];
        const t0 = performance.now();
        const id = window.setInterval(() => {
          const n = Math.min(textoMsg.length, Math.round(((performance.now() - t0) / dur) * textoMsg.length));
          composerTxt.textContent = textoMsg.slice(0, n);
          if (n >= textoMsg.length) clearInterval(id);
        }, 30);
        ciclos.push(id);
      });
      en(ms + dur + 300, () => {
        vaciar();
        humano(q, textoMsg);
      });
      return ms + dur + 300;
    }
    function vaciar() {
      composer?.removeAttribute('data-escribiendo');
      if (composerAv) composerAv.innerHTML = '';
      if (composerTxt) composerTxt.innerHTML = placeholder;
    }

    // ── Lista de agentes ──────────────────────────────────────────
    function agente(k: number, estadoTxt: string, tono: string) {
      const li = raiz.querySelector<HTMLElement>(`[data-agente="${k}"]`);
      if (!li) return;
      li.dataset.tono = tono;
      const s = li.querySelector('[data-agente-estado]');
      if (s) s.textContent = estadoTxt;
      if (animado()) { li.removeAttribute('data-cambia'); void li.offsetWidth; li.setAttribute('data-cambia', ''); }
    }
    const todosAgentes = (estadoTxt: string, tono: string) => D.agentes.forEach((_, k) => agente(k, estadoTxt, tono));

    // ── Tarjetas ──────────────────────────────────────────────────
    function tarjetaPlan() {
      return el(`<div class="sc-card" data-estado="borrador">
        <div class="sc-card-cab"><span>Plan del trimestre</span><span class="sc-tag" data-tag-borrador>Borrador</span><span class="sc-tag sc-tag-ok" data-tag-ok>Aprobado</span></div>
        ${PLAN.map(([id, que, n]) => `<div class="sc-fila">${D.av[id]}<span class="sc-fila-txt"><b>${PILARES[id]}</b><span>${esc(que)}</span></span><span class="sc-fila-der">${n}</span></div>`).join('')}
        <div class="sc-card-pie"><span class="sc-btn sc-btn-negro" data-boton-aprobar>Aprobar plan</span><span class="sc-btn" data-boton-cambios>Pedir cambios</span><span class="sc-aprobado" data-aprobado>${D.av.patrick} Aprobado por Patrick</span></div>
      </div>`);
    }
    function tarjetaReparto() {
      return el(`<div class="sc-card">
        <div class="sc-card-cab"><span>Tareas repartidas</span><span class="sc-tag sc-tag-azul"><span data-total>0</span> de 14</span></div>
        <div class="sc-chips">${D.agentes.map((a, k) => `<span class="sc-chip" data-chip="${k}">${D.av[`a${k}`]}${esc(a.nombre)}<b>${a.tareas}</b></span>`).join('')}</div>
      </div>`);
    }
    function tarjetaAvance() {
      return el(`<div class="sc-card">
        <div class="sc-card-cab"><span>En marcha</span><span class="sc-tag sc-tag-azul"><span class="sc-punto-vivo"></span>10 agentes</span></div>
        <div class="sc-avances">${D.agentes.map((a, k) => `<div class="sc-avance" data-avance="${k}" style="--c:${a.color};--t:${a.ritmo}s">${D.av[`a${k}`]}<span class="sc-avance-txt"><b>${esc(a.nombre)}</b><span>${esc(a.avance)}</span></span><span class="sc-barra"><i></i></span><span class="sc-pct" data-pct>0%</span></div>`).join('')}</div>
      </div>`);
    }
    function tarjetaRevision() {
      return el(`<div class="sc-card">
        <div class="sc-card-cab"><span>Para revisar</span><span class="sc-tag sc-tag-ambar"><span data-cola>0</span> en cola</span></div>
        ${ENTREGAS.map(([k, que], j) => `<div class="sc-fila sc-entrega" data-entrega="${j}" data-estado="oculta">${D.av[`a${k}`]}<span class="sc-fila-txt"><b>${esc(que)}</b><span>${esc(D.agentes[k].nombre)}</span></span>
          <span class="sc-fila-der"><span class="sc-estado" data-e="pendiente">Pendiente</span><span class="sc-estado" data-e="devuelto">Devuelto</span><span class="sc-estado" data-e="corrigiendo">Corrigiendo</span><span class="sc-estado" data-e="corregido">Corregido</span><span class="sc-estado" data-e="enviado">Enviado</span></span>
          ${j === 0 ? `<p class="sc-comentario">${D.av.patrick}<span>«El asunto del correo 3 suena a plantilla.»</span></p>` : ''}</div>`).join('')}
      </div>`);
    }
    function tarjetaEnvio() {
      return el(`<div class="sc-card">
        <div class="sc-card-cab"><span>Enviado al cliente</span><span class="sc-tag sc-tag-ok"><span data-enviadas>0</span> de 6</span></div>
        ${ENTREGAS.map(([k, que], j) => `<div class="sc-fila sc-envio" data-envio="${j}">${D.av[`a${k}`]}<span class="sc-fila-txt"><b>${esc(que)}</b><span>${esc(D.agentes[k].nombre)}${j === 0 ? ' · versión corregida' : ''}</span></span><span class="sc-fila-der"><span class="sc-giro"></span><span class="sc-ok">✓</span></span></div>`).join('')}
      </div>`);
    }
    // Un aviso del sistema en el hilo, centrado y pequeño.
    function aviso(k: number, t: string) {
      poner(el(`<p class="sc-aviso">${D.av[`a${k}`]}<span>${esc(t)}</span><time>${hora()}</time></p>`));
    }
    function tarjetaRegla() {
      return el(`<div class="sc-card sc-card-regla">
        <div class="sc-card-cab"><span>Regla nueva</span><span class="sc-tag sc-tag-violeta">Memoria</span></div>
        <p class="sc-regla">${D.av.a0}<span><b>Outbound</b> · asuntos cortos y sin fórmulas.</span></p>
        <p class="sc-regla-pie">Aprendida del comentario de Patrick. Se aplica desde el próximo envío.</p>
      </div>`);
    }

    // Busca en el hilo la última tarjeta de un tipo, aunque se haya pintado en otro paso.
    const ultima = (sel: string) => Array.from(hilo.querySelectorAll<HTMLElement>(sel)).pop();
    const estadoEntrega = (j: number, e: string) => {
      const f = ultima(`[data-entrega="${j}"]`);
      if (f) f.dataset.estado = e;
    };
    const contarCola = () => {
      const card = ultima('[data-cola]');
      if (!card) return;
      const filas = Array.from(hilo.querySelectorAll<HTMLElement>('[data-entrega]')).slice(-6);
      card.textContent = String(filas.filter((f) => ['pendiente', 'corregido'].includes(f.dataset.estado || '')).length);
    };

    // ── El guion, paso a paso ─────────────────────────────────────
    const guion: (() => void)[] = [
      // 1. Fijamos el objetivo
      () => {
        separador('Lunes');
        const fin = escribir('philippe', D.pasos[0].chat[0].t, 500);
        pensar(fin + 300, fin + 1900);
        en(fin + 1900, () => orq(D.pasos[0].chat[1].t));
      },
      // 2. Lo lee y propone un plan
      () => {
        pensar(200, 1500);
        let plan: HTMLElement;
        en(1500, () => { plan = tarjetaPlan(); orq(D.pasos[1].chat[0].t, plan); });
        en(4200, () => plan?.querySelector('[data-boton-aprobar]')?.setAttribute('data-hover', ''));
        const fin = escribir('patrick', D.pasos[1].chat[1].t, 4400);
        en(fin + 400, () => {
          plan?.querySelector('[data-boton-aprobar]')?.removeAttribute('data-hover');
          if (plan) plan.dataset.estado = 'aprobado';
        });
      },
      // 3. Reparte el trabajo
      () => {
        pensar(200, 1300);
        let rep: HTMLElement;
        en(1300, () => { rep = tarjetaReparto(); orq(D.pasos[2].chat[0].t, rep); });
        let total = 0;
        D.agentes.forEach((a, k) => en(2100 + k * 260, () => {
          rep?.querySelector(`[data-chip="${k}"]`)?.setAttribute('data-on', '');
          total += a.tareas;
          const t = rep?.querySelector('[data-total]');
          if (t) t.textContent = String(total);
          agente(k, `Recibió ${a.tareas} ${a.tareas === 1 ? 'tarea' : 'tareas'} · leyendo límites`, 'recibido');
        }));
      },
      // 4. Ejecutan a la vez
      () => {
        let card: HTMLElement;
        en(300, () => {
          card = tarjetaAvance();
          orq(D.pasos[3].chat[0].t, card);
        });
        D.agentes.forEach((a, k) => en(900 + k * 180, () => agente(k, a.avance, 'trabajando')));
        // El porcentaje de cada barra, al ritmo de su animación.
        const t0 = performance.now() + 300;
        const pintar = (seg: number) => card?.querySelectorAll<HTMLElement>('[data-avance]').forEach((fila) => {
          const k = Number(fila.dataset.avance);
          const pct = Math.max(0, Math.min(100, Math.round((seg / D.agentes[k].ritmo) * 100)));
          const p = fila.querySelector('[data-pct]');
          if (p) p.textContent = `${pct}%`;
          fila.style.setProperty('--p', String(pct / 100));
          fila.toggleAttribute('data-ok', pct >= 100);
        });
        if (animado()) cada(120, () => pintar((performance.now() - t0) / 1000));
        else en(300, () => pintar(T4));
      },
      // 5. Todo vuelve a nosotros
      () => {
        const listos = new Set(ENTREGAS.map(([k]) => k));
        D.agentes.forEach((a, k) => { if (!listos.has(k)) agente(k, a.avance, 'trabajando'); });
        separador('Martes');
        pensar(300, 1300);
        en(1300, () => orq(D.pasos[4].chat[0].t, tarjetaRevision()));
        ENTREGAS.forEach(([k, que], j) => en(1900 + j * 320, () => {
          estadoEntrega(j, 'pendiente');
          contarCola();
          agente(k, `Entregó: ${que.charAt(0).toLowerCase()}${que.slice(1)}`, 'revision');
        }));
        const fin = escribir('patrick', D.pasos[4].chat[1].t, 4600);
        en(fin + 300, () => {
          estadoEntrega(0, 'devuelto');
          contarCola();
          agente(0, 'Devuelto · rehaciendo el asunto del correo 3', 'error');
        });
        pensar(fin + 700, fin + 1800);
        en(fin + 1800, () => orq(D.pasos[4].chat[2].t));
        en(fin + 2600, () => { estadoEntrega(0, 'corrigiendo'); agente(0, 'Corrigiendo el correo 3', 'error'); });
        en(fin + 4600, () => {
          estadoEntrega(0, 'corregido');
          contarCola();
          agente(0, 'Corregido · esperando revisión', 'revision');
          aviso(0, 'Outbound rehízo el asunto del correo 3 y lo devolvió a la cola');
        });
      },
      // 6. Sale y el sistema aprende
      () => {
        const fin = escribir('philippe', D.pasos[5].chat[0].t, 400);
        let envio: HTMLElement;
        pensar(fin + 200, fin + 1000);
        en(fin + 1000, () => { envio = tarjetaEnvio(); orq('Perfecto. Salen las seis.', envio); });
        ENTREGAS.forEach(([k], j) => en(fin + 1500 + j * 420, () => {
          envio?.querySelector(`[data-envio="${j}"]`)?.setAttribute('data-ok', '');
          const n = envio?.querySelector('[data-enviadas]');
          if (n) n.textContent = String(j + 1);
          estadoEntrega(j, 'enviado');
          contarCola();
          agente(k, 'Enviado al cliente', 'ok');
        }));
        pensar(fin + 4300, fin + 5400);
        en(fin + 5400, () => {
          orq(D.pasos[5].chat[1].t, tarjetaRegla());
          agente(0, 'Aprendió una regla nueva', 'ok');
        });
      },
    ];

    function limpiar() {
      tiempos.forEach(clearTimeout);
      ciclos.forEach(clearInterval);
      tiempos = [];
      ciclos = [];
      vaciar();
    }

    function relojDe(i: number) {
      const [, hm] = D.pasos[i].reloj.split(' ');
      const [h, m] = hm.split(':').map(Number);
      minutoBase = h * 60 + m;
    }

    function irA(i: number) {
      limpiar();
      actual = i;
      raiz.dataset.paso = String(i + 1);

      // Lo anterior queda escrito, ya terminado.
      hilo.replaceChildren(el(`<div class="sc-intro"><span class="sc-intro-av">${D.av.orq}</span><p class="sc-intro-t">Orquestador</p><p class="sc-intro-s">Coordina a diez agentes en tres pilares. Nada sale sin que lo aprueben Philippe y Patrick.</p><p class="sc-intro-chips"><span>10 agentes</span><span>3 pilares</span><span>Revisión humana</span></p></div>`));
      todosAgentes('Esperando instrucciones', 'espera');
      instantaneo = true;
      for (let k = 0; k < i; k++) { relojDe(k); guion[k](); }
      instantaneo = false;
      hilo.querySelectorAll('.sc-entra').forEach((n) => n.classList.remove('sc-entra'));
      hilo.scrollTop = hilo.scrollHeight;

      relojDe(i);
      if (titulo) titulo.textContent = `${D.pasos[i].titulo}.`;
      if (texto) texto.textContent = D.pasos[i].texto;
      if (!reducido && narracion) {
        narracion.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 500, easing: 'cubic-bezier(.16, 1, .3, 1)' });
      }

      botones.forEach((b) => b.removeAttribute('data-actual'));
      void reproductor.offsetWidth; // reinicia el relleno del paso actual
      botones.forEach((b, k) => {
        b.toggleAttribute('data-hecho', k < i);
        b.toggleAttribute('data-actual', k === i);
        b.setAttribute('aria-current', k === i ? 'step' : 'false');
        b.style.setProperty('--dur', `${DUR[k]}ms`);
      });

      guion[i]();
      if (reproduciendo && visible) tiempos.push(window.setTimeout(() => irA((i + 1) % D.pasos.length), DUR[i]));
    }

    const pintarPlay = () => {
      raiz.toggleAttribute('data-reproduciendo', reproduciendo);
      btnPlay?.setAttribute('aria-label', reproduciendo ? 'Pausar' : 'Reproducir');
    };
    btnPlay?.addEventListener('click', () => { reproduciendo = !reproduciendo; pintarPlay(); irA(Math.max(0, actual)); });
    botones.forEach((b, k) => b.addEventListener('click', () => irA(k)));
    pintarPlay();

    // Solo corre mientras se ve. Al volver, el paso empieza de nuevo.
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) irA(Math.max(0, actual));
      else limpiar();
    }, { threshold: 0.3 }).observe(reproductor);
  });
</script>
