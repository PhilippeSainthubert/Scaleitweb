---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Servicios',
    links: [
      { label: 'Outbound B2B', href: '/servicios/outbound' },
      { label: 'SEO y contenido', href: '/servicios/seo' },
      { label: 'Agentes de IA', href: '/servicios/agentes-de-ia' },
      { label: 'RevOps y CRM', href: '/servicios/revops-crm' },
      { label: 'Paid', href: '/servicios/paid' },
      { label: 'Influencers', href: '/servicios/influencers' },
    ],
  },
  {
    title: 'Sistema',
    links: [
      { label: 'Cómo funciona', href: '/#agentes' },
      { label: 'Proceso', href: '/#proceso' },
      { label: 'Precios', href: '/precios' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Nosotros', href: '/#nosotros' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contacto', href: '/#contacto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Aviso legal', href: '/aviso-legal' },
      { label: 'Privacidad', href: '/privacidad' },
      { label: 'Cookies', href: '/cookies' },
      { label: 'Términos', href: '/terminos' },
    ],
  },
];

const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/philippesainthubert/' },
  { label: 'YouTube', href: 'https://www.youtube.com/@Marketingdetrasdelclick' },
  { label: 'X', href: 'https://x.com/Mktgdtrdelclick' },
];
---

<footer class="border-t border-line py-14">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-6">
      <div class="lg:col-span-2">
        <a href="/" class="text-[17px] font-semibold tracking-[-0.02em] text-ink">Scale It</a>
        <p class="mt-3 max-w-xs text-[14px] leading-relaxed text-ink-2">
          Construimos tu máquina de adquisición y la operamos con agentes de IA
          supervisados. Barcelona, España.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{column.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-[14px] text-ink-2 transition-colors hover:text-ink">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-line pt-6 sm:flex-row sm:items-center">
      <p class="font-mono text-[11.5px] text-ink-3">© {year} Scale It</p>
      <div class="flex gap-5">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-[13.5px] text-ink-2 transition-colors hover:text-ink">{s.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
