---
const groups = [
  { category: 'IA y agentes', tools: ['Claude', 'MCP', 'n8n', 'Make'] },
  { category: 'CRM y RevOps', tools: ['GoHighLevel', 'HubSpot', 'Pipedrive'] },
  { category: 'Datos', tools: ['GA4', 'GTM', 'BigQuery', 'Looker Studio'] },
  { category: 'Adquisición', tools: ['Google Ads', 'Meta Ads', 'LinkedIn Ads'] },
  { category: 'Web', tools: ['Astro', 'Vercel', 'Cloudflare'] },
  { category: 'Operación', tools: ['Slack', 'Notion', 'Linear'] },
];
---

<section class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Stack</p>
      <h2 class="display-lg mt-4 text-balance">Nos conectamos a lo que ya usás</h2>
      <p class="lede mt-5">
        No hay que migrar nada para empezar. Los agentes se enganchan a tus
        herramientas actuales; si algo falta, lo montamos.
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((group) => (
        <div class="bg-bg p-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{group.category}</p>
          <div class="mt-3.5 flex flex-wrap gap-1.5">
            {group.tools.map((tool) => (
              <span class="rounded-md border border-line bg-surface px-2.5 py-1 text-[13px] text-ink">{tool}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
