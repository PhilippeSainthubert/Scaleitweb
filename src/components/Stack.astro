---
/**
 * Las herramientas a las que se enganchan los agentes, en una cinta que corre.
 *
 * Va pegada a la cabecera porque responde a la primera objeción ("¿tengo que
 * cambiar de herramientas?") antes de que nadie la piense. La lista se repite
 * dos veces para que la cinta no tenga costura; la copia va oculta a lectores
 * de pantalla. Se para al pasar el ratón y queda quieta con movimiento reducido.
 */
const grupos = [
  { categoria: 'IA y agentes', herramientas: ['Claude', 'MCP', 'n8n', 'Make'] },
  { categoria: 'CRM y RevOps', herramientas: ['GoHighLevel', 'HubSpot', 'Pipedrive'] },
  { categoria: 'Datos', herramientas: ['GA4', 'GTM', 'BigQuery', 'Looker Studio'] },
  { categoria: 'Adquisición', herramientas: ['Google Ads', 'Meta Ads', 'LinkedIn Ads'] },
  { categoria: 'Web', herramientas: ['Astro', 'Vercel', 'Cloudflare'] },
  { categoria: 'Operación', herramientas: ['Slack', 'Notion', 'Linear'] },
];
---

<section class="border-b border-line bg-bg" aria-labelledby="stack-titulo">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-6 py-9 lg:flex-row lg:items-center lg:gap-10">
    <p id="stack-titulo" class="shrink-0 text-[14px] leading-snug text-ink-2 lg:max-w-[13rem]">
      <span class="font-medium text-ink">Nada que migrar.</span> Los agentes se conectan a lo que ya usás.
    </p>
    <div class="cinta" data-cinta>
      <ul class="cinta-pista">
        {[0, 1].map((copia) =>
          grupos.map((g) => (
            <li class="cinta-grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
              <span class="cinta-categoria">{g.categoria}</span>
              {g.herramientas.map((h) => <span class="cinta-herramienta">{h}</span>)}
            </li>
          ))
        )}
      </ul>
    </div>
  </div>
</section>
