---
const columns = [
  {
    label: 'En cola',
    dot: 'bg-ink-3',
    tasks: [
      { title: 'Landing B2B — borrador de copy', agent: 'strategy', time: '09:12' },
      { title: 'Secuencia outbound — 200 cuentas', agent: 'outreach', time: '09:40' },
    ],
  },
  {
    label: 'Ejecutando',
    dot: 'bg-accent animate-pulse',
    tasks: [
      { title: 'Optimización de pujas — LinkedIn Ads', agent: 'paid', time: '10:03' },
      { title: 'Dashboard de atribución en GA4', agent: 'analytics', time: '10:18' },
      { title: 'Scoring de leads en el CRM', agent: 'revops', time: '10:26' },
    ],
  },
  {
    label: 'Revisado y entregado',
    dot: 'bg-positive',
    tasks: [
      { title: 'Cualificación automática de leads', agent: 'automation', time: '08:55' },
      { title: 'Test A/B en página de precios', agent: 'strategy', time: '08:31' },
    ],
  },
];
---

<section id="agentes" class="border-t border-line bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Así trabaja</p>
      <h2 class="display-lg mt-4 text-balance">
        Mientras dormís, tus agentes siguen ejecutando
      </h2>
      <p class="lede mt-5">
        Cada agente lleva un sistema. Vos ves el estado en tiempo real, y nada sale
        en vivo sin que uno de nosotros lo revise antes.
      </p>
    </div>

    <div class="reveal mt-14 overflow-hidden rounded-xl border border-line bg-bg shadow-md">
      <!-- Barra de la consola -->
      <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
        <div class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line-2"></span>
        </div>
        <p class="ml-2 font-mono text-[11px] text-ink-3">scaleit — consola de agentes</p>
        <span class="ml-auto flex items-center gap-1.5 font-mono text-[11px] text-positive">
          <span class="h-1.5 w-1.5 rounded-full bg-positive"></span> 7 activos
        </span>
      </div>

      <div class="grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
        {columns.map((column) => (
          <div class="p-5">
            <div class="flex items-center gap-2">
              <span class={`h-1.5 w-1.5 rounded-full ${column.dot}`}></span>
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{column.label}</p>
              <span class="ml-auto font-mono text-[11px] text-ink-3">{column.tasks.length}</span>
            </div>

            <div class="mt-4 space-y-2.5">
              {column.tasks.map((task) => (
                <div class="rounded-lg border border-line bg-bg p-3.5 transition-colors hover:border-line-2">
                  <p class="text-[13.5px] leading-snug text-ink">{task.title}</p>
                  <div class="mt-2.5 flex items-center gap-2 font-mono text-[11px] text-ink-3">
                    <span class="rounded bg-surface px-1.5 py-0.5 text-accent">{task.agent}</span>
                    <span>{task.time}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
