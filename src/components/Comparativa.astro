---
const rows = [
  {
    axis: 'Alcance',
    scaleIt: 'El sistema completo: captación, atracción y operación',
    tools: 'Un canal cada vez, herramienta por herramienta',
    agency: 'Lo que diga el contrato, casi siempre fragmentado',
  },
  {
    axis: 'Velocidad',
    scaleIt: 'Los agentes ejecutan en horas, no en semanas',
    tools: 'Rápido si sabés usarla, pero lo hacés todo vos',
    agency: 'Semanas de idas, vueltas y aprobaciones',
  },
  {
    axis: 'Quién lo lleva',
    scaleIt: 'Los dos socios, con nombre y apellido',
    tools: 'Nadie. Tu propio criterio',
    agency: 'Un junior que rota cada seis meses',
  },
  {
    axis: 'Transparencia',
    scaleIt: 'Cada tarea y su estado, en tiempo real',
    tools: 'El panel de la herramienta, no el resultado',
    agency: 'Informe mensual y caja negra el resto del mes',
  },
  {
    axis: 'Coste',
    scaleIt: 'Una fracción de montar el equipo interno',
    tools: 'Barato en licencias, carísimo en tu tiempo',
    agency: 'Retainer alto más extras que aparecen luego',
  },
];
---

<section class="border-t border-line bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Comparativa</p>
      <h2 class="display-lg mt-4 text-balance">Ni la lentitud de una agencia, ni la soledad de las herramientas</h2>
    </div>

    <div class="reveal mt-12 overflow-x-auto">
      <table class="w-full min-w-[700px] border-separate border-spacing-0 text-left">
        <thead>
          <tr>
            <th class="w-[16%] pb-4 pr-4"></th>
            <th class="w-[30%] rounded-t-xl border border-b-0 border-accent/25 bg-bg px-5 pb-4 pt-5">
              <span class="text-[15px] font-semibold text-ink">Scale It</span>
            </th>
            <th class="w-[27%] px-5 pb-4 pt-5 text-[15px] font-medium text-ink-3">Herramientas sueltas</th>
            <th class="w-[27%] px-5 pb-4 pt-5 text-[15px] font-medium text-ink-3">Agencia tradicional</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr>
              <th scope="row" class="border-t border-line py-5 pr-4 align-top font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">
                {row.axis}
              </th>
              <td class={`border-x border-t border-accent/25 bg-bg px-5 py-5 align-top text-[14.5px] leading-relaxed text-ink ${i === rows.length - 1 ? 'rounded-b-xl border-b' : ''}`}>
                {row.scaleIt}
              </td>
              <td class="border-t border-line px-5 py-5 align-top text-[14.5px] leading-relaxed text-ink-2">{row.tools}</td>
              <td class="border-t border-line px-5 py-5 align-top text-[14.5px] leading-relaxed text-ink-2">{row.agency}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
