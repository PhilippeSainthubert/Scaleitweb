---
/**
 * Formulario de contacto reutilizable.
 *
 * El origen se fija en el servidor, no en el navegador: cada landing pasa el
 * suyo y así el lead llega etiquetado aunque el visitante llegue sin
 * parámetros en la URL, con JavaScript desactivado o desde un enlace pegado
 * en un correo.
 */
interface Props {
  origen: string;
  titulo?: string;
  texto?: string;
  destacar?: boolean;
}

const {
  origen,
  titulo = 'Media hora y sabés si te encajamos',
  texto = 'Miramos tu situación, te decimos dónde está el cuello de botella y qué haríamos primero. Si no somos la solución, te lo decimos en la llamada.',
  destacar = true,
} = Astro.props;

const SHEET_URL = import.meta.env.PUBLIC_SHEET_URL || '';
const SHEET_TOKEN = import.meta.env.PUBLIC_SHEET_TOKEN || '';

const sectores = [
  'Industria y fabricación',
  'Servicios técnicos B2B',
  'Despachos y consultoría especializada',
  'Software y SaaS',
  'Construcción y reformas',
  'Logística y transporte',
  'Formación y certificaciones',
  'Ecommerce y retail',
  'Otro',
];

// Horquillas, no una casilla en blanco: se responde sin pensar, no obliga a
// nadie a comprometerse con una cifra y los datos salen comparables.
const presupuestos = [
  'Menos de 1.000 € al mes',
  'Entre 1.000 € y 2.500 €',
  'Entre 2.500 € y 5.000 €',
  'Entre 5.000 € y 10.000 €',
  'Más de 10.000 €',
  'Todavía no lo tenemos definido',
];

const tipos = [
  'Quiero el sistema completo',
  'Outbound / generación de demanda',
  'SEO y contenido',
  'Agentes de IA a medida',
  'RevOps, CRM y datos',
  'Todavía no lo tengo claro',
];

const id = `form-${origen.replace(/[^a-z0-9]/gi, '-')}`;
const campo =
  'w-full rounded-lg border border-line bg-bg px-3.5 py-2.5 text-[14.5px] text-ink outline-none transition-colors placeholder:text-ink-3 focus:border-accent focus:ring-1 focus:ring-accent/30';
---

<section id="contacto" class={`border-t border-line py-24 sm:py-32 ${destacar ? 'bg-surface' : ''}`}>
  <div class="mx-auto max-w-3xl px-6">
    <div class="text-center">
      <p class="eyebrow">Contacto</p>
      <h2 class="display-lg mt-4 text-balance">{titulo}</h2>
      <p class="lede mx-auto mt-5 text-balance">{texto}</p>
    </div>

    <form
      id={id}
      data-formulario
      action="https://formsubmit.co/philosh95@gmail.com"
      method="POST"
      class="mt-12 rounded-xl border border-line bg-bg p-7 shadow-sm sm:p-9"
    >
      <input type="hidden" name="_subject" value={`Nuevo lead desde ${origen}`} />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="box" />
      <input type="hidden" name="_next" value="https://www.growth-scaleit.com/gracias" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" />

      {/* El origen viene ya puesto del servidor. La campaña y la página de
          entrada las rellena el navegador, porque dependen de la visita. */}
      <input type="hidden" name="origen" value={origen} />
      <input type="hidden" name="pagina_entrada" value="" data-pagina />
      <input type="hidden" name="campana" value="" data-campana />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for={`${id}-nombre`} class="mb-1.5 block text-[13.5px] font-medium text-ink">Nombre</label>
          <input type="text" id={`${id}-nombre`} name="nombre" required autocomplete="name" placeholder="Tu nombre" class={campo} />
        </div>
        <div>
          <label for={`${id}-empresa`} class="mb-1.5 block text-[13.5px] font-medium text-ink">Empresa</label>
          <input type="text" id={`${id}-empresa`} name="empresa" autocomplete="organization" placeholder="Nombre de la empresa" class={campo} />
        </div>
        <div>
          <label for={`${id}-email`} class="mb-1.5 block text-[13.5px] font-medium text-ink">Email de trabajo</label>
          <input type="email" id={`${id}-email`} name="email" required autocomplete="email" placeholder="tu@empresa.com" class={campo} />
        </div>
        <div>
          <label for={`${id}-web`} class="mb-1.5 block text-[13.5px] font-medium text-ink">Web</label>
          <input type="text" id={`${id}-web`} name="web" inputmode="url" placeholder="empresa.com" class={campo} />
        </div>
      </div>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <label for={`${id}-sector`} class="mb-1.5 block text-[13.5px] font-medium text-ink">¿En qué sector estás?</label>
          <select id={`${id}-sector`} name="sector" required class={campo}>
            <option value="" disabled selected>Elegí tu sector</option>
            {sectores.map((x) => <option value={x}>{x}</option>)}
          </select>
        </div>
        <div>
          <label for={`${id}-presupuesto`} class="mb-1.5 block text-[13.5px] font-medium text-ink">¿Cuánto pensás invertir al mes?</label>
          <select id={`${id}-presupuesto`} name="presupuesto" required class={campo}>
            <option value="" disabled selected>Elegí una horquilla</option>
            {presupuestos.map((x) => <option value={x}>{x}</option>)}
          </select>
        </div>
      </div>

      <div class="mt-5">
        <label for={`${id}-tipo`} class="mb-1.5 block text-[13.5px] font-medium text-ink">¿Qué necesitás?</label>
        <select id={`${id}-tipo`} name="tipo" required class={campo}>
          <option value="" disabled selected>Elegí una opción</option>
          {tipos.map((x) => <option value={x}>{x}</option>)}
        </select>
      </div>

      <div class="mt-5">
        <label for={`${id}-proyecto`} class="mb-1.5 block text-[13.5px] font-medium text-ink">Contanos el contexto</label>
        <textarea id={`${id}-proyecto`} name="proyecto" rows="4" placeholder="Qué vendés, a quién, y qué está frenando el crecimiento ahora mismo." class={`${campo} resize-y`}></textarea>
      </div>

      <button type="submit" class="btn btn-primary mt-7 w-full">Agendar la llamada</button>

      <p class="mt-4 text-center text-[12.5px] text-ink-3">
        Te respondemos en menos de 24 h laborables. Tus datos solo se usan para
        contactarte. Podés consultar la
        <a href="/privacidad" class="underline underline-offset-2 hover:text-ink">política de privacidad</a>.
      </p>
    </form>
  </div>
</section>

<script is:inline define:vars={{ SHEET_URL, SHEET_TOKEN }}>
  (function () {
    var form = document.querySelector('[data-formulario]');
    if (!form) return;

    // La primera página y la campaña se guardan al entrar: para cuando alguien
    // rellena el formulario ya ha navegado y esa información se habría perdido.
    var params = new URLSearchParams(location.search);
    function guardar(k, v) { try { if (v && !sessionStorage.getItem(k)) sessionStorage.setItem(k, v); } catch (e) {} }
    function leer(k) { try { return sessionStorage.getItem(k) || ''; } catch (e) { return ''; } }

    guardar('si-landing', location.pathname);
    var utm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content']
      .map(function (k) { return params.get(k) ? k.replace('utm_', '') + '=' + params.get(k) : null; })
      .filter(Boolean).join(' · ');
    if (utm) guardar('si-campana', utm);

    var pag = form.querySelector('[data-pagina]');
    var cam = form.querySelector('[data-campana]');
    if (pag) pag.value = leer('si-landing') || location.pathname;
    if (cam) cam.value = leer('si-campana') || 'sin campaña';

    var v = function (nombre) {
      var el = form.querySelector('[name="' + nombre + '"]');
      return el ? el.value : '';
    };

    form.addEventListener('submit', function () {
      if (SHEET_URL && SHEET_TOKEN) {
        try {
          var carga = {
            tipo: 'lead', token: SHEET_TOKEN, trampa: v('_honey'),
            nombre: v('nombre'), empresa: v('empresa'), email: v('email'), web: v('web'),
            sector: v('sector'), presupuesto: v('presupuesto'), tipo_necesidad: v('tipo'),
            proyecto: v('proyecto'), origen: v('origen'),
            pagina_entrada: v('pagina_entrada'), campana: v('campana'),
          };
          navigator.sendBeacon(SHEET_URL, new Blob([JSON.stringify(carga)], { type: 'text/plain' }));
        } catch (e) { /* si falla, el correo del formulario sigue llegando */ }
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', {
          form_id: form.id, tipo: v('tipo'), sector: v('sector'),
          presupuesto: v('presupuesto'), origen: v('origen'),
        });
      }
    });
  })();
</script>
