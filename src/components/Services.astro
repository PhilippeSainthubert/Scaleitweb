---
const pillars = [
  {
    key: 'captar',
    enlaces: [
      { label: 'Outbound B2B', href: '/servicios/outbound' },
      { label: 'Paid', href: '/servicios/paid' },
      { label: 'Influencers', href: '/servicios/influencers' },
    ],
    title: 'Captar',
    lead: 'Demanda que sale a buscarse.',
    description:
      'Outbound multicanal construido sobre señales reales de compra, no sobre listas compradas. Secuencias de email y LinkedIn, campañas de pago e influencers cuando el canal lo pide.',
    items: ['Outbound B2B', 'LinkedIn & social selling', 'Paid (Google, Meta, LinkedIn)', 'Influencers y creadores'],
  },
  {
    key: 'atraer',
    enlaces: [{ label: 'SEO y contenido', href: '/servicios/seo' }],
    title: 'Atraer',
    lead: 'Demanda que llega sola.',
    description:
      'SEO técnico y de contenido pensado para escalar: arquitectura, clusters, contenido programático y presencia en los buscadores con IA, que ya son la primera parada de tus compradores.',
    items: ['SEO técnico y de contenido', 'Contenido programático', 'AEO / buscadores con IA', 'Web y landings'],
  },
  {
    key: 'operar',
    enlaces: [
      { label: 'Agentes de IA a medida', href: '/servicios/agentes-de-ia' },
      { label: 'RevOps y CRM', href: '/servicios/revops-crm' },
    ],
    title: 'Operar',
    lead: 'El sistema que sostiene las dos.',
    description:
      'Agentes de IA a medida que ejecutan el trabajo repetitivo, conectados a tu CRM y a tus datos. Con supervisión humana en cada entrega y trazabilidad de punta a punta.',
    items: ['Agentes de IA a medida', 'RevOps y CRM', 'Tracking y atribución', 'Dashboards y reporting'],
  },
];
---

<section id="servicios" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Servicios</p>
      <h2 class="display-lg mt-4 text-balance">Tres pilares, un solo sistema</h2>
      <p class="lede mt-5">
        No es un catálogo de servicios sueltos. Es una máquina con tres partes que
        se alimentan entre sí, y que construimos y operamos nosotros.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {pillars.map((pillar, i) => (
        <article class={`card reveal p-7`} style={`transition-delay:${i * 70}ms`}>
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-[11px] text-ink-3">0{i + 1}</span>
            <h3 class="display-md">{pillar.title}</h3>
          </div>
          <p class="mt-2 text-[15px] font-medium text-accent">{pillar.lead}</p>
          <p class="mt-4 text-[14.5px] leading-relaxed text-ink-2">{pillar.description}</p>

          <ul class="mt-6 space-y-2.5 border-t border-line pt-5">
            {pillar.items.map((item) => (
              <li class="flex items-start gap-2.5 text-[14px] text-ink-2">
                <svg class="mt-[3px] h-3.5 w-3.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-line pt-5">
            {pillar.enlaces.map((e) => (
              <a href={e.href} class="inline-flex items-center gap-1 text-[13.5px] font-medium text-accent transition-colors hover:text-accent-deep">
                {e.label}
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
                </svg>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
